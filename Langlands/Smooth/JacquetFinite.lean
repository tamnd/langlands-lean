import Langlands.Smooth.Classification

/-!
# Jacquet's lemma for $GL_2$

Let $K$ be a nonarchimedean local field and $G = GL_2(K)$, with upper unipotent subgroup $N$ and diagonal torus $T$. Let $\pi$ be an admissible smooth representation of $G$. This file shows that the Jacquet module $\pi_N$ is an admissible representation of $T$, and that $\pi_N$ has finite dimension when $\pi$ is also irreducible. With this result, the classification of `Langlands.classification` applies to each irreducible admissible $\pi$ with no hypothesis on the dimension of $\pi_N$.

## Main definitions

* `Langlands.SmoothRep.jacquetN`: the Jacquet module $\pi_N$ as a smooth representation of $T$.
* `Langlands.SmoothRep.jacquetNMk`: the quotient map $\pi \to \pi_N$.
* `Langlands.GL2.torusCongruence`: the subgroup $T \cap U_\gamma$ of $T$, for the congruence subgroup $U_\gamma$ of `Langlands.GL2.congruence`.

## Main results

* `Langlands.GL2.exists_unip_mul_torus_mul_lowerUnip`: the Iwahori factorization $U_\gamma = (N \cap U_\gamma)(T \cap U_\gamma)(\bar N \cap U_\gamma)$.
* `Langlands.SmoothRep.finiteDimensional_jacquetN_fixed`: if $\pi$ is admissible, the vectors of $\pi_N$ fixed by $T \cap U_\gamma$ are a space of finite dimension.
* `Langlands.SmoothRep.jacquetN_isAdmissible`: if $\pi$ is admissible, then $\pi_N$ is admissible.
* `Langlands.SmoothRep.finiteDimensional_jacquetN`: if $\pi$ is irreducible and admissible, then $\pi_N$ has finite dimension.
* `Langlands.exists_injective_principalSeriesInd_of_isAdmissible`: an irreducible admissible $\pi$ that is not Jacquet cuspidal embeds in a principal series.
* `Langlands.classification_of_isAdmissible`: an irreducible admissible $\pi$ that is not Jacquet cuspidal is isomorphic to an irreducible normalized principal series, to a character $\chi \circ \det$, or to a twisted Steinberg representation.
* `Langlands.isJacquetCuspidal_or_classification_of_isAdmissible` and `Langlands.IrrRep.isJacquetCuspidal_or_classification`: each irreducible admissible $\pi$ is Jacquet cuspidal or is one of the representations of `Langlands.classification_of_isAdmissible`.

## Method

Each $g \in U_\gamma$ is $n(x) t \bar n(y)$ with $n(x) \in N$, $t \in T \cap U_\gamma$ and $\bar n(y) \in \bar N \cap U_\gamma$. Let $v$ be a vector fixed by $\bar N \cap U_\gamma$ whose class in $\pi_N$ is fixed by $T \cap U_\gamma$. Then the class of $\pi(g) v$ is the class of $v$ for each $g \in U_\gamma$, so the average of $v$ over $U_\gamma$ has the same class as $v$. Thus these classes are in the image $I$ of $\pi^{U_\gamma}$, which has finite dimension. The element $a = \mathrm{diag}(\varpi, 1)$ conjugates $\bar N \cap U_\gamma$ into a smaller group, so $a I \subseteq I$ and $a$ is bijective on $I$. Each class $x$ fixed by $T \cap U_\gamma$ is the class of a vector fixed by $\bar N \cap U_{\gamma'}$ for some $\gamma'$, so $a^k x \in I$ for some $k$ and thus $x \in I$. This gives admissibility of $\pi_N$. If $\pi$ is irreducible, $\pi$ is generated by one vector $v$. By the Iwasawa decomposition $G = B K_0$ and the finite index of the stabilizer of $v$ in $K_0$, the space $\pi_N$ is spanned by the $T$-translates of finitely many classes. Since $T$ is commutative, each such translate is fixed by an open subgroup of $T$ that does not depend on the translate, so $\pi_N$ is in a space of fixed vectors and has finite dimension.

## Open parts

* The file does not prove that an irreducible smooth representation of $GL_2(K)$ is admissible. This is a hypothesis of the results above.
* The file does not prove a relation between `Langlands.SmoothRep.IsJacquetCuspidal` and `Langlands.SmoothRep.IsSupercuspidal`. Each direction needs the asymptotics of matrix coefficients of Casselman, or the pairing between $\pi_N$ and the Jacquet module of the smooth dual, together with the Cartan decomposition.
-/

universe u

open Representation Matrix ValuativeRel

namespace Langlands

section Factorization

variable {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

namespace GL2

omit [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- For $v(x) < \gamma$ the matrix $n(x)$ is in the congruence subgroup of level $\gamma$. -/
theorem unip_mem_congruence {γ : ValueGroupWithZero K} (hγ0 : γ ≠ 0) (hγ1 : γ ≤ 1) {x : K}
    (hx : valuation K x < γ) : unip x ∈ congruence K γ hγ0 hγ1 := by
  have h0 : (0 : ValueGroupWithZero K) < γ := zero_lt_iff.2 hγ0
  refine ⟨fun i j => ?_, fun i j => ?_⟩
  · rw [unip_val]
    fin_cases i <;> fin_cases j <;> simp [h0, hx]
  · rw [unip_inv, unip_val]
    fin_cases i <;> fin_cases j <;> simp [h0, hx]

omit [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- For $v(y) < \gamma$ the lower unipotent matrix $\bar n(y)$ is in the congruence subgroup of level $\gamma$. -/
theorem lowerUnip_mem_congruence {γ : ValueGroupWithZero K} (hγ0 : γ ≠ 0) (hγ1 : γ ≤ 1) {y : K}
    (hy : valuation K y < γ) : lowerUnip y ∈ congruence K γ hγ0 hγ1 := by
  have h0 : (0 : ValueGroupWithZero K) < γ := zero_lt_iff.2 hγ0
  refine ⟨fun i j => ?_, fun i j => ?_⟩
  · change valuation K ((!![1, 0; y, 1] - 1 : Matrix (Fin 2) (Fin 2) K) i j) < γ
    fin_cases i <;> fin_cases j <;> simp [h0, hy]
  · change valuation K ((!![1, 0; -y, 1] - 1 : Matrix (Fin 2) (Fin 2) K) i j) < γ
    fin_cases i <;> fin_cases j <;> simp [h0, hy]

omit [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- **Iwahori factorization.** Each $g$ in the congruence subgroup $U_\gamma$ of level $\gamma \le 1$ is $n(x) \, t \, \bar n(y)$ with $t \in T \cap U_\gamma$ and $v(y) < \gamma$. -/
theorem exists_unip_mul_torus_mul_lowerUnip {γ : ValueGroupWithZero K} (hγ0 : γ ≠ 0)
    (hγ1 : γ ≤ 1) {g : GL (Fin 2) K} (hg : g ∈ congruence K γ hγ0 hγ1) :
    ∃ x y : K, valuation K y < γ ∧
      (unip x)⁻¹ * g * (lowerUnip y)⁻¹ ∈ torus K ⊓ congruence K γ hγ0 hγ1 := by
  have h11 := hg.1 1 1
  have h01 := hg.1 0 1
  have h10 := hg.1 1 0
  simp only [Matrix.sub_apply, Matrix.one_apply_eq, Matrix.one_apply_ne (by decide : (0 : Fin 2) ≠ 1),
    Matrix.one_apply_ne (by decide : (1 : Fin 2) ≠ 0), sub_zero] at h11 h01 h10
  have hd : valuation K (g.1 1 1) = 1 := by
    have := Valuation.map_eq_of_sub_lt (valuation K) (x := 1) (y := g.1 1 1)
      (by rw [map_one]; exact h11.trans_le hγ1)
    rwa [map_one] at this
  have hd0 : g.1 1 1 ≠ 0 := by
    intro h
    rw [h, map_zero] at hd
    exact zero_ne_one hd
  refine ⟨g.1 0 1 / g.1 1 1, g.1 1 0 / g.1 1 1, ?_, Subgroup.mem_inf.2 ⟨?_, ?_⟩⟩
  · rwa [map_div₀, hd, div_one]
  · rw [mem_torus]
    simp only [Units.val_mul, unip_inv, unip_val]
    change (!![1, -(g.1 0 1 / g.1 1 1); 0, 1] * g.1 * !![1, 0; -(g.1 1 0 / g.1 1 1), 1]) 1 0 = 0 ∧
      (!![1, -(g.1 0 1 / g.1 1 1); 0, 1] * g.1 * !![1, 0; -(g.1 1 0 / g.1 1 1), 1]) 0 1 = 0
    simp only [Matrix.mul_apply, Fin.sum_univ_two]
    simp
    constructor <;> field_simp <;> ring
  · refine (congruence K γ hγ0 hγ1).mul_mem ((congruence K γ hγ0 hγ1).mul_mem
      ((congruence K γ hγ0 hγ1).inv_mem (unip_mem_congruence hγ0 hγ1 ?_)) hg)
      ((congruence K γ hγ0 hγ1).inv_mem (lowerUnip_mem_congruence hγ0 hγ1 ?_))
    · rwa [map_div₀, hd, div_one]
    · rwa [map_div₀, hd, div_one]

omit [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- For $\gamma \le 1$ the congruence subgroup of level $\gamma$ is contained in $GL_2(\mathcal{O}_K)$. -/
theorem congruence_le_maxCompact {γ : ValueGroupWithZero K} (hγ0 : γ ≠ 0) (hγ1 : γ ≤ 1) :
    congruence K γ hγ0 hγ1 ≤ maxCompact K := by
  have key : ∀ M : Matrix (Fin 2) (Fin 2) K, IsSmallMatrix γ (M - 1) → IsIntegralMatrix M := by
    intro M hM i j
    have e : M i j = (M - 1) i j + (1 : Matrix (Fin 2) (Fin 2) K) i j := by simp
    rw [e]
    refine Valuation.map_add_le _ ((hM i j).le.trans hγ1) ?_
    rw [Matrix.one_apply]
    split_ifs <;> simp
  exact fun g hg => ⟨key _ hg.1, key _ hg.2⟩

/-- For $\gamma \le 1$ the congruence subgroup of level $\gamma$ is compact. -/
theorem isCompact_congruence {γ : ValueGroupWithZero K} (hγ0 : γ ≠ 0) (hγ1 : γ ≤ 1) :
    IsCompact (congruence K γ hγ0 hγ1 : Set (GL (Fin 2) K)) :=
  isCompact_maxCompact.of_isClosed_subset
    (Subgroup.isClosed_of_isOpen _ (isOpen_congruence γ hγ0 hγ1))
    (congruence_le_maxCompact hγ0 hγ1)

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- Conjugation by $\mathrm{diag}(u, 1)$ scales the lower unipotent matrices: $\mathrm{diag}(u, 1)^{-1} \bar n(y) \, \mathrm{diag}(u, 1) = \bar n(u y)$. -/
theorem diagTorusHom_inv_mul_lowerUnip_mul (u : Kˣ) (y : K) :
    ((diagTorusHom (u, 1) : torus K) : GL (Fin 2) K)⁻¹ * lowerUnip y *
      (diagTorusHom (u, 1) : torus K) = lowerUnip ((u : K) * y) := by
  rw [mul_assoc, inv_mul_eq_iff_eq_mul]
  refine Units.ext ?_
  change !![(1 : K), 0; y, 1] * !![(u : K), 0; 0, ((1 : Kˣ) : K)] =
    !![(u : K), 0; 0, ((1 : Kˣ) : K)] * !![(1 : K), 0; (u : K) * y, 1]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two, mul_comm]

end GL2

end Factorization

section Average

variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

namespace SmoothRep

/-- For a compact subgroup $U$, the average `Langlands.SmoothRep.nAverage` of $\pi(u) v$ over $U$ is fixed by $U$. Left translation by $u \in U$ permutes the cosets of $U \cap \mathrm{Stab}(v)$. -/
theorem nAverage_mem_fixedVectors (π : SmoothRep G) {U : Subgroup G}
    (hU : IsCompact (U : Set G)) (v : π.V) : π.nAverage U v ∈ fixedVectors π.ρ U := by
  have := π.finiteIndex_stabIn hU v
  have := Fintype.ofFinite (U ⧸ π.stabIn U v)
  intro k hk
  rw [nAverage, map_smul, cosetSum_eq_sum, map_sum]
  congr 1
  refine Fintype.sum_equiv (MulAction.toPerm (⟨k, hk⟩ : U)) _ _ fun q => ?_
  rw [← Module.End.mul_apply, ← map_mul]
  have h := π.ρ_eq_of_mk_eq (fun t ht => (π.mem_stabIn t).1 ht)
    (g := ⟨k, hk⟩ * Quotient.out q) (g' := Quotient.out ((⟨k, hk⟩ : U) • q)) (by
      rw [QuotientGroup.out_eq']
      conv_rhs => rw [← QuotientGroup.out_eq' q]
      rfl)
  exact h

/-- For a compact subgroup $U$ and a linear map $f$ with $f(\pi(u) v) = f(v)$ for each $u \in U$, the average of $\pi(u) v$ over $U$ has the same image $f(v)$. -/
theorem map_nAverage (π : SmoothRep G) {U : Subgroup G} (hU : IsCompact (U : Set G))
    {W : Type*} [AddCommGroup W] [Module ℂ W] (f : π.V →ₗ[ℂ] W) {v : π.V}
    (hf : ∀ g ∈ U, f (π.ρ g v) = f v) : f (π.nAverage U v) = f v := by
  have := π.finiteIndex_stabIn hU v
  have := Fintype.ofFinite (U ⧸ π.stabIn U v)
  rw [nAverage, map_smul, cosetSum_eq_sum, map_sum]
  have : ∀ q : U ⧸ π.stabIn U v, f (π.ρ ((Quotient.out q : U) : G) v) = f v :=
    fun q => hf _ (Quotient.out q).2
  simp only [this, Finset.sum_const, Finset.card_univ]
  rw [Nat.card_eq_fintype_card, ← Nat.cast_smul_eq_nsmul ℂ, inv_smul_smul₀]
  rw [Nat.cast_ne_zero, ← Nat.card_eq_fintype_card]
  exact Subgroup.FiniteIndex.index_ne_zero

end SmoothRep

end Average

section JacquetN

variable {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

open GL2

namespace SmoothRep

/-- The Jacquet module $\pi_N$ of a smooth representation $\pi$ of $GL_2(K)$ for the upper unipotent subgroup $N$, as a smooth representation of the diagonal torus $T$. -/
abbrev jacquetN (π : SmoothRep (GL (Fin 2) K)) : SmoothRep (torus K) :=
  π.jacquet (unipotent K) (torus K) torus_le_normalizer_unipotent

/-- The quotient map $V \to V_N$ for the upper unipotent subgroup $N$ of $GL_2(K)$. -/
abbrev jacquetNMk (π : SmoothRep (GL (Fin 2) K)) : π.V →ₗ[ℂ] π.jacquetN.V :=
  π.jacquetMk (unipotent K) (torus K) torus_le_normalizer_unipotent

/-- The actions of two elements of $T$ on $\pi_N$ commute. -/
theorem jacquetN_ρ_comm (π : SmoothRep (GL (Fin 2) K)) (s t : torus K) (x : π.jacquetN.V) :
    π.jacquetN.ρ s (π.jacquetN.ρ t x) = π.jacquetN.ρ t (π.jacquetN.ρ s x) := by
  rw [← Module.End.mul_apply, ← map_mul, torus_mul_comm, map_mul, Module.End.mul_apply]

end SmoothRep

end JacquetN

section JacquetModule

variable {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

open GL2


namespace GL2

variable (K) in
/-- The subgroup $T_\gamma = T \cap U_\gamma$ of the torus, for the congruence subgroup $U_\gamma$ of level $\gamma$. -/
def torusCongruence (γ : ValueGroupWithZero K) (hγ0 : γ ≠ 0) (hγ1 : γ ≤ 1) : Subgroup (torus K) :=
  (congruence K γ hγ0 hγ1).subgroupOf (torus K)

omit [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- An element of $T$ is in $T_\gamma$ exactly when it is in the congruence subgroup $U_\gamma$. -/
theorem mem_torusCongruence {γ : ValueGroupWithZero K} {hγ0 : γ ≠ 0} {hγ1 : γ ≤ 1}
    (t : torus K) : t ∈ torusCongruence K γ hγ0 hγ1 ↔ (t : GL (Fin 2) K) ∈ congruence K γ hγ0 hγ1 :=
  Subgroup.mem_subgroupOf

end GL2

namespace SmoothRep

/-- Let $w$ be fixed by the lower unipotent matrices $\bar n(y)$ with $v(y) < \gamma$, and let the class of $w$ in $\pi_N$ be fixed by $T_\gamma$. Then for each $g$ in the congruence subgroup $U_\gamma$, the classes of $\pi(g) w$ and $w$ in $\pi_N$ are equal. The proof uses the Iwahori factorization $g = n(x) \, t \, \bar n(y)$. -/
theorem jacquetNMk_ρ_congruence (π : SmoothRep (GL (Fin 2) K)) {γ : ValueGroupWithZero K}
    (hγ0 : γ ≠ 0) (hγ1 : γ ≤ 1) {w : π.V}
    (hw : ∀ y : K, valuation K y < γ → π.ρ (lowerUnip y) w = w)
    (hw' : ∀ t ∈ torusCongruence K γ hγ0 hγ1, π.jacquetN.ρ t (π.jacquetNMk w) = π.jacquetNMk w)
    {g : GL (Fin 2) K} (hg : g ∈ congruence K γ hγ0 hγ1) :
    π.jacquetNMk (π.ρ g w) = π.jacquetNMk w := by
  obtain ⟨x, y, hy, ht⟩ := exists_unip_mul_torus_mul_lowerUnip hγ0 hγ1 hg
  set t := (unip x)⁻¹ * g * (lowerUnip y)⁻¹ with ht_def
  have hg' : g = unip x * t * lowerUnip y := by
    rw [ht_def]
    group
  rw [hg', map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply, hw y hy,
    π.jacquetMk_ρ_of_mem _ (unip_mem x)]
  exact hw' ⟨t, (Subgroup.mem_inf.1 ht).1⟩ ((mem_torusCongruence _).2 (Subgroup.mem_inf.1 ht).2)

omit [IsNonarchimedeanLocalField K] [TopologicalSpace K] in
/-- Let $v$ be fixed by the $\bar n(y)$ with $v(y) < \delta$, and let $v(u y) < \delta$ for each $y$ with $v(y) < \gamma$. Then $\pi(\mathrm{diag}(u, 1)) v$ is fixed by the $\bar n(y)$ with $v(y) < \gamma$. -/
theorem ρ_lowerUnip_diagTorusHom [TopologicalSpace K] (π : SmoothRep (GL (Fin 2) K)) {u : Kˣ}
    {v : π.V} {γ δ : ValueGroupWithZero K}
    (hv : ∀ y : K, valuation K y < δ → π.ρ (lowerUnip y) v = v)
    (hu : ∀ y : K, valuation K y < γ → valuation K ((u : K) * y) < δ) (y : K)
    (hy : valuation K y < γ) :
    π.ρ (lowerUnip y) (π.ρ ((diagTorusHom (u, 1) : torus K) : GL (Fin 2) K) v) =
      π.ρ ((diagTorusHom (u, 1) : torus K) : GL (Fin 2) K) v := by
  set D : GL (Fin 2) K := ((diagTorusHom (u, 1) : torus K) : GL (Fin 2) K)
  have e : lowerUnip y * D = D * lowerUnip ((u : K) * y) := by
    rw [← diagTorusHom_inv_mul_lowerUnip_mul]
    simp [D, mul_assoc]
  rw [← Module.End.mul_apply, ← map_mul, e, map_mul, Module.End.mul_apply, hv _ (hu y hy)]

/-- **Jacquet's lemma, finite part.** Let $\pi$ be an admissible representation of $GL_2(K)$. Then for each level $0 < \gamma \le 1$ the space $(\pi_N)^{T_\gamma}$ of the vectors of the Jacquet module fixed by $T_\gamma = T \cap U_\gamma$ has finite dimension. In fact it is the image of $\pi^{U_\gamma}$. -/
theorem finiteDimensional_jacquetN_fixed (π : SmoothRep (GL (Fin 2) K)) (hπ : π.IsAdmissible)
    {γ : ValueGroupWithZero K} (hγ0 : γ ≠ 0) (hγ1 : γ ≤ 1) :
    FiniteDimensional ℂ (fixedVectors π.jacquetN.ρ (torusCongruence K γ hγ0 hγ1)) := by
  set U := congruence K γ hγ0 hγ1
  have hUc : IsCompact (U : Set (GL (Fin 2) K)) := isCompact_congruence hγ0 hγ1
  have := hπ U (isOpen_congruence γ hγ0 hγ1)
  set I : Submodule ℂ π.jacquetN.V := (fixedVectors π.ρ U).map π.jacquetNMk with hI
  have hmemI : ∀ w : π.V, (∀ y : K, valuation K y < γ → π.ρ (lowerUnip y) w = w) →
      (∀ t ∈ torusCongruence K γ hγ0 hγ1,
        π.jacquetN.ρ t (π.jacquetNMk w) = π.jacquetNMk w) → π.jacquetNMk w ∈ I := by
    intro w hw hw'
    refine ⟨π.nAverage U w, π.nAverage_mem_fixedVectors hUc w, ?_⟩
    exact π.map_nAverage hUc π.jacquetNMk fun g hg => jacquetNMk_ρ_congruence π hγ0 hγ1 hw hw' hg
  obtain ⟨c, hc⟩ := valuation_surjective (uniformizer K)
  have hc0 : c ≠ 0 := by
    rintro rfl
    have hu : uniformizer K ≠ 0 := uniformizer_ne_zero
    exact hu (by simpa using hc.symm)
  set ϖ : Kˣ := Units.mk0 c hc0
  have hϖ : ∀ (k : ℕ) (y : K), valuation K (((ϖ ^ k : Kˣ) : K) * y) =
      uniformizer K ^ k * valuation K y := by
    intro k y
    rw [map_mul, Units.val_pow_eq_pow_val, map_pow, Units.val_mk0, hc]
  set a : torus K := diagTorusHom (ϖ, 1)
  have hak : ∀ k : ℕ, a ^ k = diagTorusHom (ϖ ^ k, 1) := by
    intro k
    rw [← map_pow, Prod.pow_mk, one_pow]
  have htrans : ∀ (s : torus K) (w : π.V), (∀ t ∈ torusCongruence K γ hγ0 hγ1,
      π.jacquetN.ρ t (π.jacquetNMk w) = π.jacquetNMk w) → ∀ t ∈ torusCongruence K γ hγ0 hγ1,
      π.jacquetN.ρ t (π.jacquetNMk (π.ρ s w)) = π.jacquetNMk (π.ρ s w) := by
    intro s w hw t ht
    change π.jacquetN.ρ t (π.jacquetN.ρ s (π.jacquetNMk w)) = π.jacquetN.ρ s (π.jacquetNMk w)
    rw [jacquetN_ρ_comm, hw t ht]
  have hstab : ∀ x ∈ I, π.jacquetN.ρ a x ∈ I := by
    rintro _ ⟨v, hv, rfl⟩
    have hv' : ∀ t ∈ torusCongruence K γ hγ0 hγ1,
        π.jacquetN.ρ t (π.jacquetNMk v) = π.jacquetNMk v := fun t ht =>
      congrArg π.jacquetNMk (hv _ ((mem_torusCongruence _).1 ht))
    refine hmemI _ (ρ_lowerUnip_diagTorusHom π
      (fun y hy => hv _ (lowerUnip_mem_congruence hγ0 hγ1 hy)) (fun y hy => ?_)) (htrans a v hv')
    have := hϖ 1 y
    rw [pow_one, pow_one] at this
    rw [this]
    exact (mul_le_of_le_one_left' uniformizer_lt_one.le).trans_lt hy
  have hinv : ∀ x ∈ I, π.jacquetN.ρ a⁻¹ x ∈ I := by
    intro x hx
    let f : I →ₗ[ℂ] I := (π.jacquetN.ρ a).restrict hstab
    have hinj : Function.Injective f := by
      intro p q h
      apply Subtype.ext
      have := congrArg (fun z : I => π.jacquetN.ρ a⁻¹ z) h
      simpa [f, ← Module.End.mul_apply, ← map_mul] using this
    obtain ⟨p, hp⟩ := (LinearMap.injective_iff_surjective.1 hinj) ⟨x, hx⟩
    have : π.jacquetN.ρ a⁻¹ x = p := by
      have hpx : π.jacquetN.ρ a p = x := congrArg Subtype.val hp
      rw [← hpx]
      change π.jacquetN.ρ a⁻¹ (π.jacquetN.ρ a p) = p
      rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply]
    rw [this]
    exact p.2
  have hinvk : ∀ k : ℕ, ∀ x ∈ I, π.jacquetN.ρ (a ^ k)⁻¹ x ∈ I := by
    intro k
    induction k with
    | zero => intro x hx; simpa using hx
    | succ k ih =>
      intro x hx
      rw [pow_succ, _root_.mul_inv_rev, map_mul, Module.End.mul_apply]
      exact hinv _ (ih x hx)
  have hle : fixedVectors π.jacquetN.ρ (torusCongruence K γ hγ0 hγ1) ≤ I := by
    intro x hx
    obtain ⟨v, rfl⟩ := π.jacquetMk_surjective _ _ _ x
    have hO : IsOpen (lowerUnip ⁻¹' (vecStabilizer π.ρ v : Set (GL (Fin 2) K))) :=
      continuous_lowerUnip.isOpen_preimage _ (π.smooth v)
    have h0 : (0 : K) ∈ lowerUnip ⁻¹' (vecStabilizer π.ρ v : Set (GL (Fin 2) K)) := by
      rw [Set.mem_preimage, lowerUnip_zero]
      exact (vecStabilizer _ _).one_mem
    obtain ⟨δ, hδ⟩ := IsValuativeTopology.mem_nhds_iff'.1 (hO.mem_nhds h0)
    obtain ⟨e, he⟩ := valuation_surjective (δ : ValueGroupWithZero K)
    have he0 : e ≠ 0 := by
      rintro rfl
      exact δ.ne_zero (by simpa using he.symm)
    obtain ⟨m, hm⟩ := exists_valuation_eq_zpow he0
    have hk : uniformizer K ^ m.toNat ≤ (δ : ValueGroupWithZero K) := by
      rw [← he, hm, ← zpow_natCast]
      exact uniformizer_zpow_le_iff.2 (Int.self_le_toNat m)
    have hw := ρ_lowerUnip_diagTorusHom π (u := ϖ ^ m.toNat) (δ := δ) (γ := γ)
      (fun y hy => hδ (show valuation K (y - 0) < δ by rwa [sub_zero])) (fun y hy => by
        rw [hϖ]
        refine lt_of_lt_of_le ?_ hk
        exact mul_lt_of_lt_one_right (pow_pos uniformizer_pos _) (hy.trans_le hγ1))
    rw [← hak] at hw
    have hmem := hinvk m.toNat _ (hmemI _ hw (htrans _ v fun t ht => hx t ht))
    change π.jacquetN.ρ (a ^ m.toNat)⁻¹ (π.jacquetN.ρ (a ^ m.toNat) (π.jacquetNMk v)) ∈ I at hmem
    rwa [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply] at hmem
  exact Submodule.finiteDimensional_of_le hle

end SmoothRep

end JacquetModule

section Admissible

variable {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

open GL2

namespace GL2

/-- An open subgroup $H$ of $K^\times$ contains the units $x$ with $v(x - 1) < \gamma$, for some $\gamma \neq 0$. -/
theorem exists_valuation_sub_one_mem {H : Subgroup Kˣ} (hH : IsOpen (H : Set Kˣ)) :
    ∃ γ : ValueGroupWithZero K, γ ≠ 0 ∧ ∀ x : Kˣ, valuation K ((x : K) - 1) < γ → x ∈ H := by
  have h1 : (H : Set Kˣ) ∈ nhds (1 : Kˣ) := hH.mem_nhds H.one_mem
  rw [Units.isEmbedding_val₀.isInducing.nhds_eq_comap, Filter.mem_comap] at h1
  obtain ⟨s, hs, hsub⟩ := h1
  rw [Units.val_one, IsValuativeTopology.mem_nhds_iff'] at hs
  obtain ⟨γ, hγ⟩ := hs
  exact ⟨γ, γ.ne_zero, fun x hx => hsub (hγ hx)⟩

/-- Each open subgroup $U$ of the torus $T$ contains $T_\gamma = T \cap U_\gamma$ for some level $0 < \gamma \le 1$. -/
theorem exists_torusCongruence_le {U : Subgroup (torus K)} (hU : IsOpen (U : Set (torus K))) :
    ∃ (γ : ValueGroupWithZero K) (hγ0 : γ ≠ 0) (hγ1 : γ ≤ 1), torusCongruence K γ hγ0 hγ1 ≤ U := by
  have hc₁ : Continuous ((diagTorusHom (K := K)).comp (MonoidHom.inl Kˣ Kˣ)) :=
    continuous_diagTorusHom.comp (continuous_id.prodMk continuous_const)
  have hc₂ : Continuous ((diagTorusHom (K := K)).comp (MonoidHom.inr Kˣ Kˣ)) :=
    continuous_diagTorusHom.comp (continuous_const.prodMk continuous_id)
  obtain ⟨γ₁, hγ₁, h₁⟩ := exists_valuation_sub_one_mem
    (H := U.comap ((diagTorusHom (K := K)).comp (MonoidHom.inl Kˣ Kˣ))) (hc₁.isOpen_preimage _ hU)
  obtain ⟨γ₂, hγ₂, h₂⟩ := exists_valuation_sub_one_mem
    (H := U.comap ((diagTorusHom (K := K)).comp (MonoidHom.inr Kˣ Kˣ))) (hc₂.isOpen_preimage _ hU)
  have hγ0 : min (min γ₁ γ₂) 1 ≠ 0 := by
    rw [← zero_lt_iff] at hγ₁ hγ₂ ⊢
    exact lt_min (lt_min hγ₁ hγ₂) zero_lt_one
  refine ⟨_, hγ0, min_le_right _ _, fun t ht => ?_⟩
  rw [mem_torusCongruence] at ht
  have e1 : valuation K (((diagFst ⟨t, torus_le_borel t.2⟩ : Kˣ) : K) - 1) < γ₁ := by
    have := ht.1 0 0
    simp only [Matrix.sub_apply, Matrix.one_apply_eq] at this
    exact this.trans_le ((min_le_left _ _).trans (min_le_left _ _))
  have e2 : valuation K (((diagSnd ⟨t, torus_le_borel t.2⟩ : Kˣ) : K) - 1) < γ₂ := by
    have := ht.1 1 1
    simp only [Matrix.sub_apply, Matrix.one_apply_eq] at this
    exact this.trans_le ((min_le_left _ _).trans (min_le_right _ _))
  have m1 := h₁ _ e1
  have m2 := h₂ _ e2
  rw [Subgroup.mem_comap] at m1 m2
  rw [eq_diagTorus t]
  have e : diagTorus K (diagFst ⟨t, torus_le_borel t.2⟩) (diagSnd ⟨t, torus_le_borel t.2⟩) =
      diagTorusHom (diagFst ⟨t, torus_le_borel t.2⟩, 1) *
        diagTorusHom (1, diagSnd ⟨t, torus_le_borel t.2⟩) := by
    rw [← map_mul, Prod.mk_mul_mk, mul_one, one_mul]
    rfl
  rw [e]
  exact U.mul_mem m1 m2

end GL2

namespace SmoothRep

/-- **Jacquet's lemma.** If $\pi$ is an admissible representation of $GL_2(K)$, then its Jacquet module $\pi_N$ is an admissible representation of the torus $T$. -/
theorem jacquetN_isAdmissible (π : SmoothRep (GL (Fin 2) K)) (hπ : π.IsAdmissible) :
    π.jacquetN.IsAdmissible := by
  intro U hU
  obtain ⟨γ, hγ0, hγ1, hle⟩ := exists_torusCongruence_le hU
  have := π.finiteDimensional_jacquetN_fixed hπ hγ0 hγ1
  exact Submodule.finiteDimensional_of_le (show fixedVectors π.jacquetN.ρ U ≤
    fixedVectors π.jacquetN.ρ (torusCongruence K γ hγ0 hγ1) from fun x hx t ht => hx t (hle ht))

/-- **Finiteness of the Jacquet module.** If $\pi$ is an irreducible admissible representation of $GL_2(K)$, then its Jacquet module $\pi_N$ has finite dimension. The module $\pi_N$ is spanned by the $T$-translates of the classes of the finitely many vectors $\pi(k) v$, $k \in GL_2(\mathcal{O}_K)$, so it is fixed by an open subgroup of $T$. -/
theorem finiteDimensional_jacquetN (π : SmoothRep (GL (Fin 2) K)) (hπ : π.IsIrreducible)
    (hadm : π.IsAdmissible) : FiniteDimensional ℂ π.jacquetN.V := by
  have := hπ.1
  obtain ⟨v, hv⟩ := exists_ne (0 : π.V)
  have := π.finiteIndex_stabIn (isCompact_maxCompact (K := K)) v
  have := Fintype.ofFinite (maxCompact K ⧸ π.stabIn (maxCompact K) v)
  let x : maxCompact K ⧸ π.stabIn (maxCompact K) v → π.jacquetN.V := fun q =>
    π.jacquetNMk (π.ρ ((Quotient.out q : maxCompact K) : GL (Fin 2) K) v)
  let U' : Subgroup (torus K) := ⨅ q, vecStabilizer π.jacquetN.ρ (x q)
  have hU' : IsOpen (U' : Set (torus K)) := by
    rw [Subgroup.coe_iInf]
    exact isOpen_iInter_of_finite fun q => π.jacquetN.smooth (x q)
  let W := fixedVectors π.jacquetN.ρ U'
  have hWfin : FiniteDimensional ℂ W := jacquetN_isAdmissible π hadm U' hU'
  have hW : ∀ g, π.jacquetNMk (π.ρ g v) ∈ W := by
    intro g
    obtain ⟨b, k, hk, rfl⟩ := exists_borel_mul_maxCompact g
    obtain ⟨t, n, hn, hb⟩ := borel_eq_torus_mul_unipotent b
    let q : maxCompact K ⧸ π.stabIn (maxCompact K) v := ((⟨k, hk⟩ : maxCompact K) : _)
    have hkq : π.ρ k v = π.ρ ((Quotient.out q : maxCompact K) : GL (Fin 2) K) v :=
      π.ρ_eq_of_mk_eq (fun s hs => (π.mem_stabIn s).1 hs) (g := ⟨k, hk⟩)
        (QuotientGroup.out_eq' q).symm
    rw [hb, map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply, hkq]
    change π.jacquetN.ρ t (π.jacquetNMk (π.ρ n _)) ∈ W
    rw [π.jacquetMk_ρ_of_mem _ hn]
    intro s hs
    rw [jacquetN_ρ_comm]
    congr 1
    exact Subgroup.mem_iInf.1 hs q
  let O := Submodule.span ℂ (Set.range fun g => π.ρ g v)
  have hO : IsStableSubspace π.ρ O := by
    intro g
    refine Submodule.span_le.2 ?_
    rintro _ ⟨h, rfl⟩
    exact Submodule.subset_span ⟨g * h, by simp [map_mul]⟩
  have hOtop : O = ⊤ := by
    refine (hπ.2 O hO).resolve_left fun h => hv ?_
    have : v ∈ O := Submodule.subset_span ⟨1, by simp⟩
    rw [h] at this
    exact this
  have hOW : O ≤ W.comap π.jacquetNMk := Submodule.span_le.2 (by
    rintro _ ⟨g, rfl⟩
    exact hW g)
  have htop : W = ⊤ := by
    rw [eq_top_iff]
    intro y _
    obtain ⟨u, rfl⟩ := π.jacquetMk_surjective _ _ _ y
    exact hOW (hOtop ▸ Submodule.mem_top)
  exact Module.Finite.equiv (LinearEquiv.ofTop W htop)

end SmoothRep

end Admissible

section Classification

variable {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

open GL2 SmoothRep

/-- **Jacquet's embedding for admissible representations.** Let $\pi$ be an irreducible admissible representation of $GL_2(K)$ that is not Jacquet cuspidal. Then there are smooth characters $\alpha_1, \alpha_2$ and an injective map of representations $\pi \to \mathrm{Ind}_B^G(\alpha_1 \otimes \alpha_2)$. -/
theorem exists_injective_principalSeriesInd_of_isAdmissible (π : SmoothRep (GL (Fin 2) K))
    (hπ : π.IsIrreducible) (hadm : π.IsAdmissible) (hc : ¬ π.IsJacquetCuspidal) :
    ∃ (α₁ α₂ : Kˣ →* ℂˣ) (hα₁ : IsSmoothChar K α₁) (hα₂ : IsSmoothChar K α₂)
      (Φ : IntertwiningMap π.ρ (principalSeriesInd α₁ α₂ hα₁ hα₂).ρ), Function.Injective Φ := by
  have := π.finiteDimensional_jacquetN hπ hadm
  have := not_subsingleton_iff_nontrivial.1 hc
  exact exists_injective_principalSeriesInd π hπ

/-- **Classification for admissible representations.** Let $\pi$ be an irreducible admissible representation of $GL_2(K)$ that is not Jacquet cuspidal. Then $\pi$ is isomorphic to one of these: (1) an irreducible normalized principal series $\pi(\chi_1, \chi_2)$; (2) a character $\chi \circ \det$; (3) a twisted Steinberg representation `Langlands.steinbergSub` of $(\chi_1, \chi_2)$ with $\chi_1 = \chi_2 |\cdot|$. -/
theorem classification_of_isAdmissible (π : SmoothRep (GL (Fin 2) K)) (hπ : π.IsIrreducible)
    (hadm : π.IsAdmissible) (hc : ¬ π.IsJacquetCuspidal) :
    (∃ (χ₁ χ₂ : Kˣ →* ℂˣ) (hχ₁ : IsSmoothChar K χ₁) (hχ₂ : IsSmoothChar K χ₂),
      (normPrincipalSeries χ₁ χ₂ hχ₁ hχ₂).IsIrreducible ∧
        π.Iso (normPrincipalSeries χ₁ χ₂ hχ₁ hχ₂)) ∨
    (∃ (χ : Kˣ →* ℂˣ) (hχ : IsSmoothChar K χ),
      π.Iso (charRep (detChar K 2 χ) (isOpen_ker_detChar K 2 χ hχ))) ∨
    (∃ (χ₁ χ₂ : Kˣ →* ℂˣ) (hχ₁ : IsSmoothChar K χ₁) (hχ₂ : IsSmoothChar K χ₂)
      (h : χ₁ = χ₂ * absChar K), π.Iso (steinbergSub χ₁ χ₂ hχ₁ hχ₂ h)) := by
  have := π.finiteDimensional_jacquetN hπ hadm
  have := not_subsingleton_iff_nontrivial.1 hc
  exact classification π hπ

/-- **Dichotomy for admissible representations.** An irreducible admissible representation $\pi$ of $GL_2(K)$ is Jacquet cuspidal, or it is isomorphic to an irreducible normalized principal series, to a character $\chi \circ \det$, or to a twisted Steinberg representation. -/
theorem isJacquetCuspidal_or_classification_of_isAdmissible (π : SmoothRep (GL (Fin 2) K))
    (hπ : π.IsIrreducible) (hadm : π.IsAdmissible) :
    π.IsJacquetCuspidal ∨
    (∃ (χ₁ χ₂ : Kˣ →* ℂˣ) (hχ₁ : IsSmoothChar K χ₁) (hχ₂ : IsSmoothChar K χ₂),
      (normPrincipalSeries χ₁ χ₂ hχ₁ hχ₂).IsIrreducible ∧
        π.Iso (normPrincipalSeries χ₁ χ₂ hχ₁ hχ₂)) ∨
    (∃ (χ : Kˣ →* ℂˣ) (hχ : IsSmoothChar K χ),
      π.Iso (charRep (detChar K 2 χ) (isOpen_ker_detChar K 2 χ hχ))) ∨
    (∃ (χ₁ χ₂ : Kˣ →* ℂˣ) (hχ₁ : IsSmoothChar K χ₁) (hχ₂ : IsSmoothChar K χ₂)
      (h : χ₁ = χ₂ * absChar K), π.Iso (steinbergSub χ₁ χ₂ hχ₁ hχ₂ h)) := by
  have := π.finiteDimensional_jacquetN hπ hadm
  exact isJacquetCuspidal_or_classification π hπ

/-- **Dichotomy for the irreducible admissible representations.** Each $\pi$ in `Langlands.IrrRep` of $GL_2(K)$ is Jacquet cuspidal or is isomorphic to an irreducible normalized principal series, to a character $\chi \circ \det$, or to a twisted Steinberg representation. -/
theorem IrrRep.isJacquetCuspidal_or_classification (π : IrrRep (GL (Fin 2) K)) :
    π.1.IsJacquetCuspidal ∨
    (∃ (χ₁ χ₂ : Kˣ →* ℂˣ) (hχ₁ : IsSmoothChar K χ₁) (hχ₂ : IsSmoothChar K χ₂),
      (normPrincipalSeries χ₁ χ₂ hχ₁ hχ₂).IsIrreducible ∧
        π.1.Iso (normPrincipalSeries χ₁ χ₂ hχ₁ hχ₂)) ∨
    (∃ (χ : Kˣ →* ℂˣ) (hχ : IsSmoothChar K χ),
      π.1.Iso (charRep (detChar K 2 χ) (isOpen_ker_detChar K 2 χ hχ))) ∨
    (∃ (χ₁ χ₂ : Kˣ →* ℂˣ) (hχ₁ : IsSmoothChar K χ₁) (hχ₂ : IsSmoothChar K χ₂)
      (h : χ₁ = χ₂ * absChar K), π.1.Iso (steinbergSub χ₁ χ₂ hχ₁ hχ₂ h)) :=
  isJacquetCuspidal_or_classification_of_isAdmissible π.1 π.2.1 π.2.2

end Classification

end Langlands
