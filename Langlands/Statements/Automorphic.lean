import Langlands.Statements.Hecke
import Mathlib.LinearAlgebra.Matrix.Block
import Mathlib.MeasureTheory.Group.Measure
import Mathlib.MeasureTheory.Integral.Bochner.Basic
import Mathlib.Topology.Instances.Matrix

/-!
# Cusp forms on $GL_n$ over a number field and their Satake parameters

This file gives the vocabulary for the global statements about $GL_n$ in `Langlands.Statements.GlobalGL`. Let $K$ be a number field with adele ring $\mathbb{A}_K$. A cusp form on $GL_n$ is a function on $GL_n(K) \backslash GL_n(\mathbb{A}_K)$ that is invariant on the right under an open compact subgroup of $GL_n(\mathbb{A}_{K,f})$, has a central character, has moderate growth and has vanishing constant terms. At a finite place $v$ where the form is invariant under $GL_n(\mathcal{O}_v)$, the spherical Hecke algebra acts. It is generated by the operators $T_{v,i}$ of the double cosets of $\mathrm{diag}(\varpi_v, \ldots, \varpi_v, 1, \ldots, 1)$ with $i$ entries $\varpi_v$, for $1 \le i \le n$. A common eigenvector with eigenvalues $\lambda_i$ has the Satake parameters $\{\alpha_1, \ldots, \alpha_n\}$, the roots of
$$X^n + \sum_{i=1}^n (-1)^i q_v^{-i(n-i)/2} \lambda_i X^{n-i},$$
where $q_v$ is the size of the residue field. So $q_v^{-i(n-i)/2} \lambda_i$ is the $i$-th elementary symmetric function of the $\alpha_j$. This is the normalization in which unitary tempered representations have $|\alpha_j| = 1$.

* `Langlands.AdelicGL K n` is the group $GL_n(\mathbb{A}_K)$, and `Langlands.principalGL` is the embedding of $GL_n(K)$.
* `Langlands.localGL v` is the embedding of $GL_n(K_v)$ at a finite place $v$, with the identity at the other places.
* `Langlands.IsInLevel N k` says that $k$ is in the principal congruence subgroup $K(N)$: the identity at the infinite places and congruent to $1$ modulo $N$ in $GL_n(\mathcal{O}_v)$ at each finite place.
* `Langlands.HasVanishingConstantTerm r φ` says that the constant term of $\varphi$ along the unipotent radical of the standard maximal parabolic subgroup of type $(r, n - r)$ is zero.
* `Langlands.IsCuspForm N φ` is the condition to be a cusp form of level $K(N)$.
* `Langlands.heckeOperator v i` is the operator $T_{v,i}$, and `Langlands.IsHeckeEigenAt φ v λ` says that $\varphi$ is spherical at $v$ with $T_{v,i} \varphi = \lambda_i \varphi$ for $1 \le i \le n$.
* `Langlands.satake v λ` is the multiset of Satake parameters.
* `Langlands.IsAlgebraicRep r` says that a homomorphism $r : GL_n(\mathbb{C}) \to GL_m(\mathbb{C})$ is given by polynomials in the entries and the inverse of the determinant.
* `Langlands.IsobaricCuspData K m` is a finite family of nonzero cusp forms on $GL_{m_i}$ with $\sum m_i = m$. It stands for the isobaric sum of the representations that the forms generate.

## Implementation notes

The cusp forms here are continuous functions, not smooth and $K_\infty$-finite functions. The growth condition is $|\varphi(g)| \le C |\det g|^s$ for real constants $C$ and $s$. There is no condition at the infinite places: no finiteness under $K_\infty$ and no condition under the center of the universal enveloping algebra. These choices give the same Hecke eigensystems at the unramified places as the cuspidal automorphic representations. A cusp form of the usual kind is rapidly decreasing modulo the center, so it is a form in this sense. Conversely, let $\varphi$ be a form in this sense. After a twist by a power of $|\det|$, it is bounded, so it is in the space $L^2_{\mathrm{cusp}}$ of its central character, which is a Hilbert direct sum of cuspidal automorphic representations $\pi$. The Hecke operators at unramified places commute with the projections, so each nonzero projection of $\varphi$ is a spherical vector of some $\pi$ with the eigenvalues of $\varphi$.

The constant term is an integral over $N_r(K) \backslash N_r(\mathbb{A}_K)$, where $N_r$ is the group of the matrices $\begin{pmatrix} 1 & X \\ 0 & 1 \end{pmatrix}$ with $X$ of size $r \times (n - r)$. This quotient is a power of the compact group $\mathbb{A}_K / K$. The definition integrates over all of $(\mathbb{A}_K / K)^{n \times n}$ and uses only the entries in the block of $X$. The function depends only on the classes of the entries, because $\varphi$ is left invariant under $GL_n(K)$ and $N_r$ is commutative. The definition quantifies over all invariant probability measures. There is exactly one, the Haar measure, but Mathlib does not yet know that $\mathbb{A}_K / K$ is compact.

The Hecke operator $T_{v,i}$ is a finite sum over explicit representatives of $GL_n(\mathcal{O}_v) \, \mathrm{diag}(\varpi_v^{(i)}, 1^{(n-i)}) \, GL_n(\mathcal{O}_v) / GL_n(\mathcal{O}_v)$. These are the upper triangular matrices with diagonal entries $\varpi_v$ on a set $s$ of $i$ indices and $1$ on the others, with an entry from a fixed set of representatives of $\mathcal{O}_K / \mathfrak{p}_v$ at each position $(j, k)$ with $j < k$, $j \in s$ and $k \notin s$, and $0$ at the other positions above the diagonal. There are $\binom{n}{i}_{q_v}$ of them. On a spherical form the sum does not depend on the choices.

The unramified computation fixes the normalization. For the spherical vector of the unramified principal series with parameters $\alpha_j$, the operator $T_{v,i}$ acts by $q_v^{i(n-i)/2} e_i(\alpha_1, \ldots, \alpha_n)$. Another common convention gives the inverse parameters $\alpha_j^{-1}$. The statements in `Langlands.Statements.GlobalGL` have the same meaning in both conventions, because the contragredient of a cuspidal automorphic representation is again one.

## References

* D. Bump, Automorphic forms and representations, chapter 3.
* A. Borel and H. Jacquet, Automorphic forms and automorphic representations, in Automorphic forms, representations and L-functions, Proc. Sympos. Pure Math. 33, part 1, 1979.
* J. Cogdell, Lectures on L-functions, converse theorems, and functoriality for $GL_n$, in Lectures on automorphic L-functions, Fields Inst. Monogr. 20, 2004.
-/

namespace Langlands

open NumberField IsDedekindDomain

open scoped Classical

universe u

variable (K : Type u) [Field K] [NumberField K] (n : ℕ)

/-- The group $GL_n(\mathbb{A}_K)$ of invertible $n \times n$ matrices over the adele ring of $K$. It has the topology of the units of the topological ring of matrices. -/
abbrev AdelicGL : Type u :=
  GL (Fin n) (AdeleRing (𝓞 K) K)

/-- The compact group $\mathbb{A}_K / K$. -/
abbrev AdeleQuotient : Type u :=
  AdeleRing (𝓞 K) K ⧸ AdeleRing.principalSubgroup (𝓞 K) K

variable {K n}

/-- The embedding $GL_n(K) \to GL_n(\mathbb{A}_K)$ on the diagonal. -/
noncomputable def principalGL : GL (Fin n) K →* AdelicGL K n :=
  Matrix.GeneralLinearGroup.map (algebraMap K (AdeleRing (𝓞 K) K))

/-- The scalar matrix $z \cdot 1 \in GL_n(\mathbb{A}_K)$ for an idele $z$. -/
noncomputable def scalarGL (z : (AdeleRing (𝓞 K) K)ˣ) : AdelicGL K n :=
  Units.map (Matrix.scalar (Fin n) : AdeleRing (𝓞 K) K →+* _).toMonoidHom z

/-- The adele with the component $x$ at the finite place $v$ and $0$ at the other places. -/
noncomputable def adeleSingle (v : HeightOneSpectrum (𝓞 K)) :
    v.adicCompletion K →+ AdeleRing (𝓞 K) K where
  toFun x := (0, RestrictedProduct.single (fun w : HeightOneSpectrum (𝓞 K) ↦
    w.adicCompletionIntegers K) v x)
  map_zero' := Prod.ext rfl (RestrictedProduct.single_zero _ v)
  map_add' x y := Prod.ext (add_zero 0).symm (RestrictedProduct.single_add _ v x y)

theorem adeleSingle_mul (v : HeightOneSpectrum (𝓞 K)) (x y : v.adicCompletion K) :
    adeleSingle v (x * y) = adeleSingle v x * adeleSingle v y := by
  refine Prod.ext (mul_zero 0).symm ?_
  have h := RestrictedProduct.single_mul (fun w : HeightOneSpectrum (𝓞 K) ↦
    w.adicCompletionIntegers K) v x (RestrictedProduct.single _ v y)
  rw [RestrictedProduct.single_eq_same] at h
  exact h

theorem adeleSingle_mapMatrix_mul (v : HeightOneSpectrum (𝓞 K))
    (A B : Matrix (Fin n) (Fin n) (v.adicCompletion K)) :
    (adeleSingle v).mapMatrix (A * B) =
      (adeleSingle v).mapMatrix A * (adeleSingle v).mapMatrix B := by
  ext i j
  simp [Matrix.mul_apply, map_sum, adeleSingle_mul]

/-- The adelic matrix with the component $M$ at the finite place $v$ and the identity at the other places. -/
noncomputable def localMatrix (v : HeightOneSpectrum (𝓞 K)) :
    Matrix (Fin n) (Fin n) (v.adicCompletion K) →* Matrix (Fin n) (Fin n) (AdeleRing (𝓞 K) K) where
  toFun M := 1 + (adeleSingle v).mapMatrix (M - 1)
  map_one' := by simp
  map_mul' M N := by
    have h : M * N - 1 = (M - 1) + (N - 1) + (M - 1) * (N - 1) := by noncomm_ring
    rw [h, map_add, map_add, adeleSingle_mapMatrix_mul]
    noncomm_ring

/-- The embedding $GL_n(K_v) \to GL_n(\mathbb{A}_K)$ at a finite place $v$, with the identity at the other places. -/
noncomputable def localGL (v : HeightOneSpectrum (𝓞 K)) :
    GL (Fin n) (v.adicCompletion K) →* AdelicGL K n :=
  Units.map (localMatrix v)

/-- An element $k \in GL_n(\mathbb{A}_K)$ is in the principal congruence subgroup $K(N)$ of level $N \in \mathcal{O}_K$ if its components at the infinite places are the identity and, at each finite place $v$, the entries of $k_v - 1$ and of $k_v^{-1} - 1$ have valuation at most $|N|_v$. So $k_v \in GL_n(\mathcal{O}_v)$ and $k_v \equiv 1 \pmod{N}$. -/
def IsInLevel (N : 𝓞 K) (k : AdelicGL K n) : Prop :=
  (∀ i j, ((k : Matrix (Fin n) (Fin n) (AdeleRing (𝓞 K) K)) i j).1 =
    (1 : Matrix (Fin n) (Fin n) (InfiniteAdeleRing K)) i j) ∧
  ∀ (v : HeightOneSpectrum (𝓞 K)) (i j : Fin n),
    Valued.v (((k : Matrix (Fin n) (Fin n) (AdeleRing (𝓞 K) K)) i j).2 v -
        (1 : Matrix (Fin n) (Fin n) (v.adicCompletion K)) i j) ≤
      Valued.v (algebraMap K (v.adicCompletion K) (N : K)) ∧
    Valued.v ((((k⁻¹ : AdelicGL K n) : Matrix (Fin n) (Fin n) (AdeleRing (𝓞 K) K)) i j).2 v -
        (1 : Matrix (Fin n) (Fin n) (v.adicCompletion K)) i j) ≤
      Valued.v (algebraMap K (v.adicCompletion K) (N : K))

/-- The matrix $\begin{pmatrix} 0 & X \\ 0 & 0 \end{pmatrix}$, where $X$ is the block of the rows $i < r$ and the columns $j \ge r$ of the given array. -/
noncomputable def blockMask (r : ℕ) (X : Fin n → Fin n → AdeleRing (𝓞 K) K) :
    Matrix (Fin n) (Fin n) (AdeleRing (𝓞 K) K) :=
  Matrix.of fun i j ↦ if (i : ℕ) < r ∧ r ≤ (j : ℕ) then X i j else 0

theorem blockMask_mul_blockMask (r : ℕ) (X Y : Fin n → Fin n → AdeleRing (𝓞 K) K) :
    blockMask r X * blockMask r Y = 0 := by
  ext i j
  simp only [blockMask, Matrix.mul_apply, Matrix.of_apply, Matrix.zero_apply]
  refine Finset.sum_eq_zero fun l _ ↦ ?_
  split_ifs with h₁ h₂ <;> first | simp | omega

/-- The unipotent element $\begin{pmatrix} 1 & X \\ 0 & 1 \end{pmatrix}$ of the unipotent radical $N_r(\mathbb{A}_K)$ of the standard parabolic subgroup of type $(r, n - r)$. Its inverse is $\begin{pmatrix} 1 & -X \\ 0 & 1 \end{pmatrix}$. -/
noncomputable def unipotentGL (r : ℕ) (X : Fin n → Fin n → AdeleRing (𝓞 K) K) : AdelicGL K n where
  val := 1 + blockMask r X
  inv := 1 - blockMask r X
  val_inv := by rw [add_mul, mul_sub, mul_sub, blockMask_mul_blockMask]; noncomm_ring
  inv_val := by rw [sub_mul, mul_add, mul_add, blockMask_mul_blockMask]; noncomm_ring

/-- The constant term of $\varphi$ along $N_r$ vanishes: for each $g \in GL_n(\mathbb{A}_K)$,
$$\int_{N_r(K) \backslash N_r(\mathbb{A}_K)} \varphi(u g) \, du = 0.$$
The integral is over $(\mathbb{A}_K / K)^{n \times n}$ with an invariant probability measure, and the integrand uses a lift of each entry to $\mathbb{A}_K$. Only the entries in the block of $N_r$ enter. -/
def HasVanishingConstantTerm (r : ℕ) (φ : AdelicGL K n → ℂ) : Prop :=
  letI : MeasurableSpace (AdeleQuotient K) := borel _
  ∀ μ : MeasureTheory.Measure (Fin n → Fin n → AdeleQuotient K),
    MeasureTheory.IsProbabilityMeasure μ → μ.IsAddLeftInvariant →
      ∀ g : AdelicGL K n,
        ∫ x, φ (unipotentGL r (fun i j ↦ Quotient.out (x i j)) * g) ∂μ = 0

/-- A cusp form on $GL_n$ over $K$ of level $K(N)$, for a nonzero $N \in \mathcal{O}_K$. It is a continuous function $\varphi : GL_n(\mathbb{A}_K) \to \mathbb{C}$ with these properties.

* It is left invariant under $GL_n(K)$.
* It is right invariant under the principal congruence subgroup $K(N)$.
* It has a central character: $\varphi(g z) = \omega(z) \varphi(g)$ for the scalar matrices $z \in \mathbb{A}_K^\times$.
* It has moderate growth: $|\varphi(g)| \le C |\det g|^s$ for some real $C$ and $s$.
* Its constant terms along the unipotent radicals of the standard maximal parabolic subgroups are zero. -/
structure IsCuspForm (N : 𝓞 K) (φ : AdelicGL K n → ℂ) : Prop where
  continuous : Continuous φ
  left_invariant : ∀ (γ : GL (Fin n) K) (g : AdelicGL K n), φ (principalGL γ * g) = φ g
  level_ne_zero : N ≠ 0
  right_invariant : ∀ k : AdelicGL K n, IsInLevel N k → ∀ g, φ (g * k) = φ g
  central : ∃ ω : (AdeleRing (𝓞 K) K)ˣ → ℂ, ∀ z g, φ (g * scalarGL z) = ω z * φ g
  growth : ∃ C s : ℝ, ∀ g : AdelicGL K n,
    ‖φ g‖ ≤ C * ‖(g : Matrix (Fin n) (Fin n) (AdeleRing (𝓞 K) K)).det‖ ^ s
  cuspidal : ∀ r : ℕ, 0 < r → r < n → HasVanishingConstantTerm r φ

/-- An element of $GL_n(K_v)$ is in $GL_n(\mathcal{O}_v)$ if the entries of it and of its inverse are integral. -/
def IsIntegralGL (v : HeightOneSpectrum (𝓞 K)) (k : GL (Fin n) (v.adicCompletion K)) : Prop :=
  ∀ i j, Valued.v ((k : Matrix (Fin n) (Fin n) (v.adicCompletion K)) i j) ≤ 1 ∧
    Valued.v ((k⁻¹ : GL (Fin n) (v.adicCompletion K)) i j) ≤ 1

/-- A function on $GL_n(\mathbb{A}_K)$ is spherical at $v$ if it is right invariant under $GL_n(\mathcal{O}_v)$. -/
def IsSphericalAt (φ : AdelicGL K n → ℂ) (v : HeightOneSpectrum (𝓞 K)) : Prop :=
  ∀ k, IsIntegralGL v k → ∀ g, φ (g * localGL v k) = φ g

variable (K n) in
/-- The index set of the right cosets in $GL_n(\mathcal{O}_v) \, \mathrm{diag}(\varpi_v^{(i)}, 1^{(n-i)}) \, GL_n(\mathcal{O}_v)$: a set $s$ of $i$ indices, and a residue class modulo $\mathfrak{p}_v$ for each position $(j, k)$ with $j < k$, $j \in s$ and $k \notin s$. -/
def HeckeCoset (v : HeightOneSpectrum (𝓞 K)) (i : ℕ) : Type u :=
  Σ s : {s : Finset (Fin n) // s.card = i},
    {p : Fin n × Fin n // p.1 < p.2 ∧ p.1 ∈ s.1 ∧ p.2 ∉ s.1} → 𝓞 K ⧸ v.asIdeal

/-- The coset representative: the upper triangular matrix with diagonal entries $\varpi_v$ at the indices in $s$ and $1$ at the others, and with a lift of the given residue class at each allowed position. -/
noncomputable def heckeCosetMatrix (v : HeightOneSpectrum (𝓞 K)) {i : ℕ} (c : HeckeCoset K n v i) :
    Matrix (Fin n) (Fin n) (v.adicCompletion K) :=
  Matrix.of fun j k ↦
    if j = k then (if j ∈ c.1.1 then (localUniformizer K v : v.adicCompletion K) else 1)
    else if h : j < k ∧ j ∈ c.1.1 ∧ k ∉ c.1.1 then
      algebraMap K (v.adicCompletion K) ((Quotient.out (c.2 ⟨(j, k), h⟩) : 𝓞 K) : K)
    else 0

theorem heckeCosetMatrix_isUpperTriangular (v : HeightOneSpectrum (𝓞 K)) {i : ℕ}
    (c : HeckeCoset K n v i) : (heckeCosetMatrix v c).IsUpperTriangular := by
  intro j k hkj
  have h₁ : j ≠ k := (ne_of_lt hkj).symm
  have h₂ : ¬ (j < k ∧ j ∈ c.1.1 ∧ k ∉ c.1.1) := fun h ↦ (lt_asymm h.1 hkj).elim
  simp [heckeCosetMatrix, h₁, h₂]

theorem heckeCosetMatrix_det_ne_zero (v : HeightOneSpectrum (𝓞 K)) {i : ℕ}
    (c : HeckeCoset K n v i) : (heckeCosetMatrix v c).det ≠ 0 := by
  rw [Matrix.det_of_isUpperTriangular (heckeCosetMatrix_isUpperTriangular v c)]
  refine Finset.prod_ne_zero_iff.2 fun j _ ↦ ?_
  simp only [heckeCosetMatrix, Matrix.of_apply, ite_true]
  split_ifs
  · exact Units.ne_zero _
  · exact one_ne_zero

/-- The coset representative as an element of $GL_n(K_v)$. -/
noncomputable def heckeCosetGL (v : HeightOneSpectrum (𝓞 K)) {i : ℕ} (c : HeckeCoset K n v i) :
    GL (Fin n) (v.adicCompletion K) :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero _ (heckeCosetMatrix_det_ne_zero v c)

/-- The Hecke operator $T_{v,i}$: $(T_{v,i} \varphi)(g) = \sum_c \varphi(g h_c)$, where $h_c$ runs over the representatives of $GL_n(\mathcal{O}_v) \, \mathrm{diag}(\varpi_v^{(i)}, 1^{(n-i)}) \, GL_n(\mathcal{O}_v) / GL_n(\mathcal{O}_v)$ in `heckeCosetGL`. -/
noncomputable def heckeOperator (v : HeightOneSpectrum (𝓞 K)) (i : ℕ) (φ : AdelicGL K n → ℂ) :
    AdelicGL K n → ℂ :=
  fun g ↦ ∑ᶠ c : HeckeCoset K n v i, φ (g * localGL v (heckeCosetGL v c))

/-- The function $\varphi$ is spherical at $v$ and an eigenvector of $T_{v,i}$ with eigenvalue $\lambda_i$, for $1 \le i \le n$. -/
def IsHeckeEigenAt (φ : AdelicGL K n → ℂ) (v : HeightOneSpectrum (𝓞 K)) (ev : ℕ → ℂ) : Prop :=
  IsSphericalAt φ v ∧ ∀ i, 1 ≤ i → i ≤ n → heckeOperator v i φ = ev i • φ

/-- The function $\varphi$ is a Hecke eigenform: it is a Hecke eigenvector at all finite places outside a finite set. -/
def IsHeckeEigenform (φ : AdelicGL K n → ℂ) : Prop :=
  ∃ S : Set (HeightOneSpectrum (𝓞 K)), S.Finite ∧ ∀ v ∉ S, ∃ ev : ℕ → ℂ, IsHeckeEigenAt φ v ev

variable (n) in
/-- The Satake polynomial $X^n + \sum_{i=1}^n (-1)^i q^{-i(n-i)/2} \lambda_i X^{n-i}$. -/
noncomputable def satakePolynomial (q : ℕ) (ev : ℕ → ℂ) : Polynomial ℂ :=
  Polynomial.X ^ n + ∑ i ∈ Finset.Icc 1 n,
    Polynomial.C ((-1) ^ i * (((q : ℝ) ^ (-((i * (n - i) : ℕ) : ℝ) / 2) : ℝ) : ℂ) * ev i) *
      Polynomial.X ^ (n - i)

variable (n) in
/-- The Satake parameters at $v$ of a Hecke eigenvector with eigenvalues $\lambda_i$: the multiset of the roots of the Satake polynomial with $q = q_v = |\mathcal{O}_K / \mathfrak{p}_v|$. -/
noncomputable def satake (v : HeightOneSpectrum (𝓞 K)) (ev : ℕ → ℂ) : Multiset ℂ :=
  (satakePolynomial n (Ideal.absNorm v.asIdeal) ev).roots

/-- A homomorphism $r : GL_n(\mathbb{C}) \to GL_m(\mathbb{C})$ is algebraic if each entry of $r(g)$ is a polynomial in the entries of $g$ and in $\det(g)^{-1}$. The variable `none` stands for $\det(g)^{-1}$. -/
def IsAlgebraicRep {m : ℕ} (r : GL (Fin n) ℂ →* GL (Fin m) ℂ) : Prop :=
  ∃ P : Fin m → Fin m → MvPolynomial (Option (Fin n × Fin n)) ℂ,
    ∀ (g : GL (Fin n) ℂ) (i j : Fin m),
      (r g : Matrix (Fin m) (Fin m) ℂ) i j =
        MvPolynomial.eval (fun o ↦ Option.elim o
          ((g : Matrix (Fin n) (Fin n) ℂ).det)⁻¹ (fun p ↦ (g : Matrix (Fin n) (Fin n) ℂ) p.1 p.2))
          (P i j)

/-- The diagonal matrix $\mathrm{diag}(\alpha_1, \ldots, \alpha_n) \in GL_n(\mathbb{C})$. -/
noncomputable def diagonalGL (α : Fin n → ℂˣ) : GL (Fin n) ℂ :=
  Units.map (Matrix.diagonalRingHom (Fin n) ℂ).toMonoidHom (MulEquiv.piUnits.symm α)

variable (K) in
/-- A finite family of nonzero cusp forms $\varphi_j$ on $GL_{m_j}$ over $K$ with $\sum_j m_j = m$. It stands for the isobaric sum $\Pi_1 \boxplus \cdots \boxplus \Pi_k$ of the automorphic representations that they generate. At an unramified place the Satake parameters of the sum are the union of those of the $\Pi_j$. -/
structure IsobaricCuspData (m : ℕ) where
  /-- The number of summands. -/
  card : ℕ
  /-- The sizes $m_j$. -/
  size : Fin card → ℕ
  /-- The levels. -/
  level : Fin card → 𝓞 K
  /-- The cusp forms. -/
  form : (j : Fin card) → AdelicGL K (size j) → ℂ
  isCuspForm : ∀ j, IsCuspForm (level j) (form j)
  ne_zero : ∀ j, form j ≠ 0
  sum_size : ∑ j, size j = m

/-- The isobaric sum has the Satake parameters $A$ at $v$: there are Hecke eigenvalues $\mu_j$ of the summands at $v$, and the union of their Satake parameters is $A$. -/
def IsobaricCuspData.HasSatakeAt {m : ℕ} (D : IsobaricCuspData K m) (v : HeightOneSpectrum (𝓞 K))
    (A : Multiset ℂ) : Prop :=
  ∃ μ : Fin D.card → ℕ → ℂ, (∀ j, IsHeckeEigenAt (D.form j) v (μ j)) ∧
    ∑ j, satake (D.size j) v (μ j) = A

/-! ### Sanity checks -/

/-- The constant function $1$ is a cusp form on $GL_1$ of level $1$. For $n = 1$ there is no proper parabolic subgroup, so the cuspidal condition is empty. -/
theorem isCuspForm_one : IsCuspForm (K := K) (n := 1) 1 (fun _ ↦ 1) where
  continuous := continuous_const
  left_invariant _ _ := rfl
  level_ne_zero := one_ne_zero
  right_invariant _ _ _ := rfl
  central := ⟨1, fun _ _ ↦ by simp⟩
  growth := ⟨1, 0, fun _ ↦ by simp⟩
  cuspidal r h₁ h₂ := by omega

/-- For $n = 1$ the Satake parameter is the Hecke eigenvalue: the Satake polynomial is $X - \lambda_1$. -/
theorem satakePolynomial_one (q : ℕ) (ev : ℕ → ℂ) :
    satakePolynomial 1 q ev = Polynomial.X - Polynomial.C (ev 1) := by
  simp [satakePolynomial, sub_eq_add_neg]

theorem satake_one (v : HeightOneSpectrum (𝓞 K)) (ev : ℕ → ℂ) : satake 1 v ev = {ev 1} := by
  rw [satake, satakePolynomial_one, Polynomial.roots_X_sub_C]

instance (v : HeightOneSpectrum (𝓞 K)) : Subsingleton (HeckeCoset K 1 v 1) := by
  refine ⟨?_⟩
  rintro ⟨⟨s, hs⟩, x⟩ ⟨⟨s', hs'⟩, x'⟩
  obtain rfl : s = s' := by
    rw [Finset.eq_univ_of_card s (by simpa using hs), Finset.eq_univ_of_card s' (by simpa using hs')]
  congr
  funext p
  have h := p.2.1
  have := p.1.1.isLt
  have := p.1.2.isLt
  rw [Fin.lt_def] at h
  omega

/-- For $n = 1$ the operator $T_{v,1}$ is the right translation by the element $\varpi_v$ at $v$. -/
theorem exists_heckeOperator_one_eq (v : HeightOneSpectrum (𝓞 K)) :
    ∃ t : AdelicGL K 1, ∀ (φ : AdelicGL K 1 → ℂ) g, heckeOperator v 1 φ g = φ (g * t) := by
  let c₀ : HeckeCoset K 1 v 1 := ⟨⟨Finset.univ, by simp⟩, fun p ↦ by
    have h := p.2.1
    have := p.1.1.isLt
    have := p.1.2.isLt
    rw [Fin.lt_def] at h
    omega⟩
  let _ : Unique (HeckeCoset K 1 v 1) := uniqueOfSubsingleton c₀
  exact ⟨localGL v (heckeCosetGL v c₀), fun φ g ↦ finsum_unique _⟩

end Langlands
