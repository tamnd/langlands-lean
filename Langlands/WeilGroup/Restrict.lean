import Langlands.WeilGroup.Inertia
import Langlands.Ported.NYLL.ValuedFieldTheory.LocalField.NonarchimedeanLocalField.FiniteExtensionTopology
import Langlands.Ported.NYLL.GaloisCohomology.Topology.GaloisConjugation

/-!
# The Weil group of a finite extension as an open subgroup

For a finite extension $L$ of $K$ inside $\bar K$, this file defines the subgroup of $W_K$ of the elements that fix $L$, and proves that it is open, of finite index, and normal when $L / K$ is normal. Then it identifies the Weil group $W_L$ with this subgroup.

* `Langlands.WeilGroup.restrictSubgroup`: the elements of $W_K$ that fix $L$, with `isOpen_restrictSubgroup`, `finiteIndex_restrictSubgroup` and `normal_restrictSubgroup`.
* `Langlands.WeilGroup.map_degree_restrictSubgroup`: the degree map sends the subgroup onto $f \mathbb{Z}$, where $f$ is `residueDegree K L`.
* `Langlands.WeilGroup.weilHom`: an injective continuous homomorphism $W_L \to W_K$ with image `restrictSubgroup K L` (`range_weilHom`).
* `Langlands.WeilGroup.degree_weilHom`: the degree of the image of $w$ is $f$ times the degree of $w$, where $f$ is the residue degree of $L / K$ (`residueDegree_eq_residueFinrank`).

## Implementation notes

The structure of a nonarchimedean local field on $L$ comes from the spectral norm of the port. Its instances are scoped to the namespace `Langlands.WeilGroup.FiniteExt`. The map `weilHom` depends on a choice of an isomorphism $\bar L \cong \bar K$ over $L$, but its image does not.
-/

namespace Langlands.WeilGroup

/-- The subgroup of `Multiplicative ℤ` generated by `a` has index the absolute value of `a`. -/
theorem index_zpowers_ofAdd (a : ℤ) :
    (Subgroup.zpowers (Multiplicative.ofAdd a)).index = a.natAbs := by
  have h : AddSubgroup.toSubgroup (AddSubgroup.zmultiples a) =
      Subgroup.zpowers (Multiplicative.ofAdd a) := by
    ext x
    simp [Subgroup.mem_zpowers_iff, AddSubgroup.mem_zmultiples_iff]
    refine exists_congr fun k => ?_
    rw [← ofAdd_zsmul, smul_eq_mul]
    exact ⟨fun h => by rw [h]; rfl, fun h => by rw [← h]; rfl⟩
  rw [← h, AddSubgroup.index_toSubgroup, Int.index_zmultiples]

/-- A subgroup of `Multiplicative ℤ` is generated by its index. -/
theorem eq_zpowers_index (H : Subgroup (Multiplicative ℤ)) :
    H = Subgroup.zpowers (Multiplicative.ofAdd (H.index : ℤ)) := by
  obtain ⟨g, rfl⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top H).mp inferInstance
  rw [show g = Multiplicative.ofAdd (Multiplicative.toAdd g) from rfl, index_zpowers_ofAdd]
  rcases Int.natAbs_eq (Multiplicative.toAdd g) with h | h
  · rw [← h]
  · rw [show (Multiplicative.toAdd g).natAbs = -(Multiplicative.toAdd g) by omega, ofAdd_neg, Subgroup.zpowers_inv]

open LocalField

universe u

variable (K : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

variable (L : IntermediateField K (AlgebraicClosure K))

/-- The elements of the Weil group that fix the intermediate field $L$ pointwise. For finite $L$ this is the Weil group of $L$, seen inside $W_K$. -/
noncomputable def restrictSubgroup : Subgroup (WeilGroup K) :=
  (L.fixingSubgroup : Subgroup (Field.absoluteGaloisGroup K)).comap (toGalois K)

theorem mem_restrictSubgroup (w : WeilGroup K) :
    w ∈ restrictSubgroup K L ↔ ∀ x ∈ L, toGalois K w • x = x := by
  exact IntermediateField.mem_fixingSubgroup_iff _ _

/-- For a finite extension, the subgroup `restrictSubgroup K L` is open. -/
theorem isOpen_restrictSubgroup [FiniteDimensional K L] :
    IsOpen (restrictSubgroup K L : Set (WeilGroup K)) :=
  L.fixingSubgroup_isOpen.preimage (continuous_toGalois K)

/-- For a finite extension, the subgroup `restrictSubgroup K L` has finite index. -/
instance finiteIndex_restrictSubgroup [FiniteDimensional K L] :
    (restrictSubgroup K L).FiniteIndex := by
  set H : Subgroup (Field.absoluteGaloisGroup K) := L.fixingSubgroup
  have hfin : Finite (Field.absoluteGaloisGroup K ⧸ H) :=
    Subgroup.quotient_finite_of_isOpen (G := Gal(AlgebraicClosure K/K)) _ L.fixingSubgroup_isOpen
  have : H.FiniteIndex := Subgroup.finiteIndex_of_finite_quotient
  exact inferInstanceAs (H.comap (toGalois K)).FiniteIndex

/-- For a normal extension, `restrictSubgroup K L` is the kernel of the restriction map to $\mathrm{Gal}(L / K)$. -/
theorem restrictSubgroup_eq_ker [Normal K L] : restrictSubgroup K L = (restrict K L).ker :=
  (ker_restrict K L).symm

/-- For a normal extension, the subgroup `restrictSubgroup K L` is normal. -/
instance normal_restrictSubgroup [Normal K L] : (restrictSubgroup K L).Normal := by
  rw [restrictSubgroup_eq_ker]
  infer_instance

/-- The residue degree of $L / K$, defined as the index in $\mathbb{Z}$ of the image of `restrictSubgroup K L` under the degree map. -/
noncomputable def residueDegree : ℕ :=
  ((restrictSubgroup K L).map (degree K)).index

/-- The residue degree divides the index of `restrictSubgroup K L` in $W_K$. -/
theorem residueDegree_dvd_index : residueDegree K L ∣ (restrictSubgroup K L).index :=
  Subgroup.index_map_dvd _ (degree_surjective K)

/-- The degree map sends `restrictSubgroup K L` onto the multiples of the residue degree. -/
theorem map_degree_restrictSubgroup :
    (restrictSubgroup K L).map (degree K) =
      Subgroup.zpowers (Multiplicative.ofAdd (residueDegree K L : ℤ)) :=
  eq_zpowers_index _

/-- For a finite extension, the residue degree is positive. -/
theorem residueDegree_pos [FiniteDimensional K L] : 0 < residueDegree K L :=
  Nat.pos_of_ne_zero fun h => (restrictSubgroup K L).index_ne_zero_of_finite
    (Nat.eq_zero_of_zero_dvd (h ▸ residueDegree_dvd_index K L))

/-- For a finite extension, the degree map sends `restrictSubgroup K L` onto $f \mathbb{Z}$ for a positive integer $f$. -/
theorem exists_map_degree_restrictSubgroup [FiniteDimensional K L] :
    ∃ f : ℕ, 0 < f ∧ (restrictSubgroup K L).map (degree K) =
      Subgroup.zpowers (Multiplicative.ofAdd (f : ℤ)) :=
  ⟨_, residueDegree_pos K L, map_degree_restrictSubgroup K L⟩

end Langlands.WeilGroup

/-! ## The Weil group of a finite extension

For a finite extension $L$ of $K$ inside $\bar K$, the field $L$ is given the spectral norm over $K$, which makes it a nonarchimedean local field. The map `weilHom K L` is a continuous injective homomorphism from $W_L$ to $W_K$ with image `restrictSubgroup K L`.
-/

namespace Langlands.WeilGroup

open LocalField LocalFieldTheory ValuativeRel

open scoped Pointwise

universe u

variable (K : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

variable (L : IntermediateField K (AlgebraicClosure K)) [FiniteDimensional K L]

namespace FiniteExt
noncomputable scoped instance : NontriviallyNormedField L := finiteExtensionSpectralNormedField K L
noncomputable scoped instance : ValuativeRel L := finiteExtensionSpectralValuativeRel K L
scoped instance : IsNonarchimedeanLocalField L := finiteExtensionSpectralIsNonarchimedeanLocalField K L
end FiniteExt
open Langlands.WeilGroup.FiniteExt

/-- For the norm of the valuation of `K`, the closed unit ball is `𝒪[K]`. -/
theorem norm_le_one_iff_base (x : K) :
    (localFieldNontriviallyNormedField K).norm x ≤ 1 ↔ x ∈ 𝒪[K] := by
  let := IsTopologicalAddGroup.rightUniformSpace K
  have := isUniformAddGroup_of_addCommGroup (G := K)
  let hr : (Valued.v (R := K)).RankOne :=
  { hom' := IsRankLeOne.nonempty.some.emb (R := K).comp MonoidWithZeroHom.ValueGroup₀.embedding
    strictMono' := IsRankLeOne.nonempty.some.strictMono.comp
        MonoidWithZeroHom.ValueGroup₀.embedding_strictMono }
  exact Valued.toNormedField.norm_le_one_iff (L := K) (Γ₀ := ValuativeRel.ValueGroupWithZero K)

/-- An element of `L` is in `𝒪[L]` if and only if its spectral norm over `K` is at most one. -/
theorem mem_integer_iff_spectralNorm (x : L) :
    letI : NontriviallyNormedField K := localFieldNontriviallyNormedField K
    x ∈ 𝒪[L] ↔ spectralNorm K L x ≤ 1 := by
  let := finiteExtensionSpectralIsUltrametricDist K L
  let v : Valuation L NNReal := NormedField.valuation (K := L)
  have : v.Compatible := Valuation.Compatible.ofValuation v
  exact (Valuation.vle_one_iff (ValuativeRel.valuation L) (x := x)).symm.trans
    (Valuation.vle_one_iff v (x := x))

/-- The ring `𝒪[L]` is the integral closure of `𝒪[K]` in `L`. -/
theorem mem_integer_iff_isIntegral (x : L) : x ∈ 𝒪[L] ↔ IsIntegral 𝒪[K] x := by
  let : NontriviallyNormedField K := localFieldNontriviallyNormedField K
  have := localFieldIsUltrametricDist K
  rw [mem_integer_iff_spectralNorm]
  constructor
  · exact isIntegral_of_spectralNorm_le_one (R := 𝒪[K])
      (fun y hy => ⟨⟨y, (norm_le_one_iff_base K y).mp hy⟩, rfl⟩)
  · exact spectralNorm_le_one_of_isIntegral (R := 𝒪[K])
      (fun r => (norm_le_one_iff_base K _).mpr r.2)

/-- The valuation of `L` extends the valuation of `K`. -/
instance hasExtension_finite : (valuation K).HasExtension (valuation L) :=
  finiteExtensionSpectralValuation_hasExtension K L

instance isScalarTower_integer_finite : IsScalarTower 𝒪[K] 𝒪[L] L :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

instance isScalarTower_integer_algClosure : IsScalarTower 𝒪[K] 𝒪[L] (AlgebraicClosure K) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

instance isIntegral_integer_finite : Algebra.IsIntegral 𝒪[K] 𝒪[L] := by
  refine ⟨fun x => ?_⟩
  have h := (mem_integer_iff_isIntegral K L x).mp x.2
  exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom 𝒪[K] 𝒪[L] L) Subtype.val_injective).mp h

/-- An element of the algebraic closure of `K` is integral over `𝒪[L]` if and only if it is integral over `𝒪[K]`. -/
theorem isIntegral_integer_iff (z : AlgebraicClosure K) :
    IsIntegral 𝒪[L] z ↔ IsIntegral 𝒪[K] z :=
  ⟨fun h => isIntegral_trans z h, fun h => h.tower_top⟩
instance isAlgClosure_intermediateField : IsAlgClosure L (AlgebraicClosure K) :=
  ⟨inferInstance, Algebra.IsAlgebraic.tower_top (K := K) _⟩

/-- An isomorphism of `AlgebraicClosure L` with `AlgebraicClosure K` over `L`. -/
noncomputable def algClosureEquiv : AlgebraicClosure L ≃ₐ[L] AlgebraicClosure K :=
  IsAlgClosure.equiv L _ _

/-- The inclusion of $\mathrm{Gal}(\bar K / L)$ into $\mathrm{Gal}(\bar K / K)$. -/
noncomputable def restrictScalarsHom : Gal(AlgebraicClosure K/L) →* Gal(AlgebraicClosure K/K) where
  toFun σ := σ.restrictScalars K
  map_one' := rfl
  map_mul' _ _ := rfl

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [FiniteDimensional K L] in
theorem restrictScalarsHom_injective : Function.Injective (restrictScalarsHom K L) :=
  fun _ _ h => AlgEquiv.ext fun x => congrArg (fun ρ : Gal(AlgebraicClosure K/K) => ρ x) h

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [FiniteDimensional K L] in
theorem range_restrictScalarsHom : (restrictScalarsHom K L).range = L.fixingSubgroup := by
  ext σ
  constructor
  · rintro ⟨τ, rfl⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact τ.commutes ⟨x, hx⟩
  · intro hσ
    exact ⟨IntermediateField.fixingSubgroupEquiv L ⟨σ, hσ⟩, AlgEquiv.ext fun _ => rfl⟩

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
theorem continuous_restrictScalarsHom : Continuous (restrictScalarsHom K L) := by
  refine continuous_of_continuousAt_one (restrictScalarsHom K L) ?_
  rw [ContinuousAt, MonoidHom.map_one, Filter.Tendsto]
  intro s hs
  obtain ⟨F, hF, hFs⟩ := (krullTopology_mem_nhds_one_iff K (AlgebraicClosure K) s).1 hs
  have : FiniteDimensional K F := hF
  let LF : IntermediateField K (AlgebraicClosure K) := L ⊔ F
  let E : IntermediateField L (AlgebraicClosure K) :=
    IntermediateField.extendScalars (F := L) (E := LF) le_sup_left
  have : FiniteDimensional K LF := L.finiteDimensional_sup F
  have : FiniteDimensional L E := by
    let _ : Algebra L LF := (IntermediateField.inclusion le_sup_left).toAlgebra
    have : IsScalarTower K L LF := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have : Module.Finite L LF := FiniteDimensional.right K L LF
    let e : E ≃ₗ[L] LF :=
      { toFun x := ⟨x.1, x.2⟩
        invFun x := ⟨x.1, x.2⟩
        left_inv _ := rfl
        right_inv _ := rfl
        map_add' _ _ := rfl
        map_smul' _ _ := rfl }
    exact Module.Finite.equiv e.symm
  refine (krullTopology_mem_nhds_one_iff L (AlgebraicClosure K) _).2 ⟨E, inferInstance, ?_⟩
  intro σ hσ
  apply hFs
  rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  exact (IntermediateField.mem_fixingSubgroup_iff E σ).1 hσ x ((show F ≤ LF from le_sup_right) hx)

/-- The inclusion of the absolute Galois group of `L` into that of `K`. -/
noncomputable def galoisHom : Field.absoluteGaloisGroup L →* Field.absoluteGaloisGroup K :=
  (restrictScalarsHom K L).comp (AlgEquiv.autCongr (algClosureEquiv K L)).toMonoidHom

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [FiniteDimensional K L] in
/-- The map `galoisHom K L` is injective. -/
theorem galoisHom_injective : Function.Injective (galoisHom K L) :=
  (restrictScalarsHom_injective K L).comp (AlgEquiv.autCongr (algClosureEquiv K L)).injective

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- The map `galoisHom K L` is continuous for the Krull topologies. -/
theorem continuous_galoisHom : Continuous (galoisHom K L) :=
  (continuous_restrictScalarsHom K L).comp
    (RamificationTheory.Field.absoluteGaloisGroup.algEquiv_autCongr_continuous _)

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [FiniteDimensional K L] in
/-- The image of `galoisHom K L` is the subgroup fixing `L`. -/
theorem range_galoisHom : (galoisHom K L).range = L.fixingSubgroup := by
  rw [← range_restrictScalarsHom K L]
  ext g
  constructor
  · rintro ⟨σ, rfl⟩
    exact ⟨_, rfl⟩
  · rintro ⟨τ, rfl⟩
    obtain ⟨σ, rfl⟩ := (AlgEquiv.autCongr (algClosureEquiv K L)).surjective τ
    exact ⟨σ, rfl⟩

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [FiniteDimensional K L] in
/-- The map `galoisHom K L` is conjugation by `algClosureEquiv K L`. -/
theorem galoisHom_apply (σ : Field.absoluteGaloisGroup L) (x : AlgebraicClosure L) :
    (show AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K from galoisHom K L σ)
        (algClosureEquiv K L x) =
      algClosureEquiv K L ((show AlgebraicClosure L ≃ₐ[L] AlgebraicClosure L from σ) x) := by
  change algClosureEquiv K L ((show AlgebraicClosure L ≃ₐ[L] AlgebraicClosure L from σ)
    ((algClosureEquiv K L).symm (algClosureEquiv K L x))) = _
  rw [AlgEquiv.symm_apply_apply]

/-- The isomorphism `algClosureEquiv K L` matches the elements integral over `𝒪[L]` with the elements integral over `𝒪[K]`. -/
theorem isIntegral_algClosureEquiv_iff (y : AlgebraicClosure L) :
    IsIntegral 𝒪[K] (algClosureEquiv K L y) ↔ IsIntegral 𝒪[L] y := by
  rw [← isIntegral_integer_iff K L]
  exact isIntegral_algHom_iff ((algClosureEquiv K L).toAlgHom.restrictScalars 𝒪[L])
    (algClosureEquiv K L).injective

/-- The isomorphism of `integers L` with `integers K` induced by `algClosureEquiv K L`. -/
noncomputable def integersEquiv : integers L ≃+* integers K where
  toFun y := ⟨algClosureEquiv K L y, (isIntegral_algClosureEquiv_iff K L y).mpr y.2⟩
  invFun z := ⟨(algClosureEquiv K L).symm z, by
    change IsIntegral _ _
    rw [← isIntegral_algClosureEquiv_iff K L, AlgEquiv.apply_symm_apply]
    exact z.2⟩
  left_inv y := Subtype.ext ((algClosureEquiv K L).symm_apply_apply y)
  right_inv z := Subtype.ext ((algClosureEquiv K L).apply_symm_apply z)
  map_mul' x y := Subtype.ext (map_mul (algClosureEquiv K L) (x : AlgebraicClosure L) y)
  map_add' x y := Subtype.ext (map_add (algClosureEquiv K L) (x : AlgebraicClosure L) y)

theorem coe_integersEquiv (y : integers L) :
    (integersEquiv K L y : AlgebraicClosure K) = algClosureEquiv K L y :=
  rfl

/-- The isomorphism `integersEquiv K L` sends `prime L` to `prime K`. -/
theorem map_prime_integersEquiv : (prime L).map (integersEquiv K L) = prime K := by
  have : ((prime L).map (integersEquiv K L)).IsMaximal :=
    Ideal.map_isMaximal_of_equiv _
  exact eq_prime_of_isMaximal K _

/-- The isomorphism of `residueFieldBar L` with `residueFieldBar K` induced by `algClosureEquiv K L`. -/
noncomputable def residueBarEquiv : residueFieldBar L ≃+* residueFieldBar K :=
  Ideal.quotientEquiv _ _ (integersEquiv K L) (map_prime_integersEquiv K L).symm

theorem residueBarEquiv_mk (y : integers L) :
    residueBarEquiv K L (Ideal.Quotient.mk (prime L) y) =
      Ideal.Quotient.mk (prime K) (integersEquiv K L y) :=
  rfl

theorem integersEquiv_smul (σ : Field.absoluteGaloisGroup L) (y : integers L) :
    integersEquiv K L (σ • y) = galoisHom K L σ • integersEquiv K L y :=
  Subtype.ext (by
    rw [coe_integersEquiv, coe_smul_integers, coe_smul_integers, coe_integersEquiv]
    exact (galoisHom_apply K L σ y).symm)

/-- The isomorphism `residueBarEquiv K L` intertwines the actions of `σ` and of its image under `galoisHom K L`. -/
theorem residueBarEquiv_residueAut (σ : Field.absoluteGaloisGroup L) (x : residueFieldBar L) :
    residueBarEquiv K L (residueAut L σ x) = residueAut K (galoisHom K L σ) (residueBarEquiv K L x) := by
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [residueAut_mk, residueBarEquiv_mk, residueBarEquiv_mk, residueAut_mk, integersEquiv_smul]

instance liesOver_maximalIdeal_finite : (𝓂[L]).LiesOver 𝓂[K] :=
  ⟨(IsLocalRing.maximalIdeal_comap (algebraMap 𝒪[K] 𝒪[L])).symm⟩

/-- The degree of the residue field of `L` over the residue field of `K`. -/
noncomputable def residueFinrank : ℕ :=
  Module.finrank (residueField K) (residueField L)

theorem residueFinrank_pos : 0 < residueFinrank K L := by
  have : Module.Finite (residueField K) (residueField L) := Module.Finite.of_finite
  exact Module.finrank_pos

/-- The residue field of `L` has `q ^ f` elements, where `q` is the order of the residue field of `K` and `f` is the residue degree. -/
theorem card_residueField_eq_pow :
    Fintype.card (residueField L) = Fintype.card (residueField K) ^ residueFinrank K L := by
  have : Module.Finite (residueField K) (residueField L) := Module.Finite.of_finite
  exact Module.card_eq_pow_finrank

/-- The isomorphism `residueBarEquiv K L` sends the Frobenius of `L` to a power of the Frobenius of `K`, with exponent the residue degree. -/
theorem residueBarEquiv_frobenius (x : residueFieldBar L) :
    residueBarEquiv K L (LocalField.frobenius L x) =
      (LocalField.frobenius K ^ residueFinrank K L) (residueBarEquiv K L x) := by
  rw [LocalField.frobenius, LocalField.frobenius, AlgEquiv.coe_pow,
    FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate,
    FiniteField.coe_frobeniusAlgEquivOfAlgebraic, ← card_residueField_eq_pow]
  exact map_pow _ _ _

local notation "ΓK" => residueFieldBar K ≃ₐ[residueField K] residueFieldBar K
local notation "ΓL" => residueFieldBar L ≃ₐ[residueField L] residueFieldBar L

/-- The automorphisms of `residueFieldBar K` over `residueField K`, as ring automorphisms. -/
noncomputable def toRingAutK : ΓK →* RingAut (residueFieldBar K) :=
  MonoidHom.mk' AlgEquiv.toRingEquiv fun _ _ => rfl

/-- The automorphisms of `residueFieldBar L` over `residueField L`, transported to ring automorphisms of `residueFieldBar K`. -/
noncomputable def toRingAutL : ΓL →* RingAut (residueFieldBar K) :=
  MonoidHom.mk' (fun τ => ((residueBarEquiv K L).symm.trans τ.toRingEquiv).trans (residueBarEquiv K L))
    fun a b => RingEquiv.ext fun x => by
      change residueBarEquiv K L (a (b ((residueBarEquiv K L).symm x))) =
        residueBarEquiv K L (a ((residueBarEquiv K L).symm
          (residueBarEquiv K L (b ((residueBarEquiv K L).symm x)))))
      rw [RingEquiv.symm_apply_apply]

omit [FiniteDimensional K L] in
theorem toRingAutK_injective : Function.Injective (toRingAutK K) :=
  fun _ _ h => AlgEquiv.ext fun x => RingEquiv.congr_fun h x

theorem toRingAutL_injective : Function.Injective (toRingAutL K L) := by
  intro a b h
  refine AlgEquiv.ext fun x => (residueBarEquiv K L).injective ?_
  have := RingEquiv.congr_fun h (residueBarEquiv K L x)
  simpa [toRingAutL] using this

theorem toRingAutL_residueAut (σ : Field.absoluteGaloisGroup L) :
    toRingAutL K L (residueAut L σ) = toRingAutK K (residueAut K (galoisHom K L σ)) := by
  refine RingEquiv.ext fun y => ?_
  obtain ⟨x, rfl⟩ := (residueBarEquiv K L).surjective y
  change residueBarEquiv K L (residueAut L σ ((residueBarEquiv K L).symm (residueBarEquiv K L x))) = _
  rw [RingEquiv.symm_apply_apply, residueBarEquiv_residueAut]
  rfl

theorem toRingAutL_frobenius_zpow (n : ℤ) :
    toRingAutL K L (LocalField.frobenius L ^ n) =
      toRingAutK K (LocalField.frobenius K ^ ((residueFinrank K L : ℤ) * n)) := by
  have h1 : toRingAutL K L (LocalField.frobenius L) =
      toRingAutK K (LocalField.frobenius K ^ residueFinrank K L) := by
    refine RingEquiv.ext fun y => ?_
    obtain ⟨x, rfl⟩ := (residueBarEquiv K L).surjective y
    change residueBarEquiv K L (LocalField.frobenius L
      ((residueBarEquiv K L).symm (residueBarEquiv K L x))) = _
    rw [RingEquiv.symm_apply_apply, residueBarEquiv_frobenius]
    rfl
  rw [map_zpow, h1, ← map_zpow, zpow_mul, zpow_natCast]


/-- An element of the absolute Galois group of `L` that acts on residues as a power of the Frobenius of `L` acts, through `galoisHom K L`, as a power of the Frobenius of `K`. -/
theorem galoisHom_mem_weilSubgroup {σ : Field.absoluteGaloisGroup L} (hσ : σ ∈ weilSubgroup L) :
    galoisHom K L σ ∈ weilSubgroup K := by
  rw [← SetLike.mem_coe, coe_weilSubgroup] at hσ ⊢
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hσ
  refine Subgroup.mem_zpowers_iff.mpr ⟨(residueFinrank K L : ℤ) * n, toRingAutK_injective K ?_⟩
  rw [← toRingAutL_frobenius_zpow, hn, toRingAutL_residueAut]

/-- If the action on residues of the image of `σ` is the `n`-th power of the Frobenius of `K`, then the residue degree divides `n`. -/
theorem residueFinrank_dvd {σ : Field.absoluteGaloisGroup L} {n : ℤ}
    (h : residueAut K (galoisHom K L σ) = LocalField.frobenius K ^ n) :
    (residueFinrank K L : ℤ) ∣ n := by
  classical
  set m := residueFinrank K L
  set q := Fintype.card (residueField K)
  have hq : 1 < q := Fintype.one_lt_card
  have hm : 0 < m := residueFinrank_pos K L
  set ψ := residueBarEquiv K L
  set ι := algebraMap (residueField L) (residueFieldBar L)
  set S : Finset (residueFieldBar K) := Finset.univ.image fun a => ψ (ι a)
  have hS : S.card = q ^ m := by
    rw [Finset.card_image_of_injective (f := fun a => ψ (ι a)) _
      (ψ.injective.comp ι.injective), Finset.card_univ, card_residueField_eq_pow]
  have hfix : ∀ z ∈ S, LocalField.frobenius K ^ ((n % m).toNat) ∈
      MulAction.stabilizer (residueFieldBar K ≃ₐ[residueField K] residueFieldBar K) z := by
    intro z hz
    obtain ⟨a, -, rfl⟩ := Finset.mem_image.mp hz
    have h1 : LocalField.frobenius K ^ n ∈ MulAction.stabilizer _ (ψ (ι a)) := by
      change (LocalField.frobenius K ^ n) (ψ (ι a)) = ψ (ι a)
      rw [← h, ← residueBarEquiv_residueAut]
      exact congrArg ψ ((residueAut L σ).commutes a)
    have h2 : LocalField.frobenius K ^ (m : ℤ) ∈ MulAction.stabilizer _ (ψ (ι a)) := by
      change (LocalField.frobenius K ^ (m : ℤ)) (ψ (ι a)) = ψ (ι a)
      rw [zpow_natCast, ← residueBarEquiv_frobenius]
      exact congrArg ψ ((LocalField.frobenius L).commutes a)
    have h3 : LocalField.frobenius K ^ (n % m) ∈ MulAction.stabilizer _ (ψ (ι a)) := by
      rw [Int.emod_def, zpow_sub, zpow_mul]
      exact Subgroup.mul_mem _ h1 (Subgroup.inv_mem _ (Subgroup.zpow_mem _ h2 _))
    have h4 : (n % m) = (((n % m).toNat : ℕ) : ℤ) :=
      (Int.toNat_of_nonneg (Int.emod_nonneg _ (by exact_mod_cast hm.ne'))).symm
    rw [h4, zpow_natCast] at h3
    exact h3
  have hnn : 0 ≤ n % m := Int.emod_nonneg _ (by exact_mod_cast hm.ne')
  set r := (n % m).toNat
  have hr : r < m := by
    have := Int.emod_lt_of_pos n (by exact_mod_cast hm : (0 : ℤ) < m)
    omega
  by_cases hr0 : r = 0
  · have : n % m = 0 := by omega
    exact Int.dvd_of_emod_eq_zero this
  exfalso
  have hp := FiniteField.X_pow_card_pow_sub_X_ne_zero (residueFieldBar K) hr0 hq
  have hroots : S.val ⊆ (Polynomial.X ^ q ^ r - Polynomial.X : Polynomial (residueFieldBar K)).roots := by
    intro z hz
    rw [Polynomial.mem_roots hp, Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow,
      Polynomial.eval_X, sub_eq_zero]
    have := hfix z hz
    change (LocalField.frobenius K ^ r) z = z at this
    rwa [LocalField.frobenius, AlgEquiv.coe_pow,
      FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate] at this
  have hle := Polynomial.card_le_degree_of_subset_roots hroots
  rw [FiniteField.X_pow_card_pow_sub_X_natDegree_eq _ hr0 hq, hS] at hle
  exact absurd (Nat.pow_lt_pow_right hq hr) (not_lt.mpr hle)

/-- If the image of `σ` lies in the Weil group of `K`, then `σ` lies in the Weil group of `L`. -/
theorem mem_weilSubgroup_of_galoisHom {σ : Field.absoluteGaloisGroup L}
    (hσ : galoisHom K L σ ∈ weilSubgroup K) : σ ∈ weilSubgroup L := by
  rw [← SetLike.mem_coe, coe_weilSubgroup] at hσ ⊢
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hσ
  obtain ⟨k, rfl⟩ := residueFinrank_dvd K L hn.symm
  refine Subgroup.mem_zpowers_iff.mpr ⟨k, toRingAutL_injective K L ?_⟩
  rw [toRingAutL_frobenius_zpow, hn, toRingAutL_residueAut]

/-- The inclusion `weilHom K L` of the Weil group of a finite extension. -/
noncomputable def weilHom : WeilGroup L →* WeilGroup K where
  toFun w := ⟨galoisHom K L (toGalois L w), galoisHom_mem_weilSubgroup K L w.2⟩
  map_one' := Subtype.ext (map_one (galoisHom K L))
  map_mul' a b := Subtype.ext (map_mul (galoisHom K L) (toGalois L a) (toGalois L b))

theorem toGalois_weilHom (w : WeilGroup L) :
    toGalois K (weilHom K L w) = galoisHom K L (toGalois L w) :=
  rfl

theorem toRingAutK_toResidue_weilHom (w : WeilGroup L) :
    toRingAutK K (toResidue K (weilHom K L w)) = toRingAutL K L (toResidue L w) :=
  (toRingAutL_residueAut K L (toGalois L w)).symm

/-- The inclusion `weilHom K L` is injective. -/
theorem weilHom_injective : Function.Injective (weilHom K L) := fun _ _ h =>
  toGalois_injective L (galoisHom_injective K L (congrArg (toGalois K) h))

/-- The inclusion `weilHom K L` is continuous. -/
theorem continuous_weilHom : Continuous (weilHom K L) := by
  refine continuous_inf_rng.mpr ⟨continuous_induced_rng.mpr ?_, continuous_induced_rng.mpr ?_⟩
  · exact (continuous_galoisHom K L).comp (continuous_toGalois L)
  · let t : TopologicalSpace (residueFieldBar K ≃ₐ[residueField K] residueFieldBar K) := ⊥
    have : DiscreteTopology (residueFieldBar K ≃ₐ[residueField K] residueFieldBar K) := ⟨rfl⟩
    refine continuous_def.mpr fun U _ => ?_
    have hU : (toResidue K ∘ weilHom K L) ⁻¹' U = ⋃ τ ∈ {τ | ∃ τ' ∈ U, toRingAutK K τ' = toRingAutL K L τ},
        toResidue L ⁻¹' {τ} := by
      ext w
      simp only [Set.mem_preimage, Function.comp_apply, Set.mem_iUnion, Set.mem_singleton_iff,
        Set.mem_ofPred_eq, exists_prop]
      constructor
      · intro hw
        exact ⟨_, ⟨_, hw, toRingAutK_toResidue_weilHom K L w⟩, rfl⟩
      · rintro ⟨τ, ⟨τ', hτ', he⟩, rfl⟩
        rw [← toRingAutK_toResidue_weilHom, (toRingAutK_injective K).eq_iff] at he
        exact he ▸ hτ'
    rw [hU]
    exact isOpen_biUnion fun τ _ => isOpen_fiber_toResidue L τ

/-- The image of `weilHom K L` is `restrictSubgroup K L`. -/
theorem range_weilHom : (weilHom K L).range = restrictSubgroup K L := by
  ext g
  constructor
  · rintro ⟨w, rfl⟩
    change galoisHom K L (toGalois L w) ∈ L.fixingSubgroup
    rw [← range_galoisHom K L]
    exact ⟨_, rfl⟩
  · intro hg
    have hg' : toGalois K g ∈ (galoisHom K L).range := by
      rw [range_galoisHom]
      exact hg
    obtain ⟨σ, hσ⟩ := hg'
    have hmem : σ ∈ weilSubgroup L := mem_weilSubgroup_of_galoisHom K L (hσ ▸ g.2)
    exact ⟨⟨σ, hmem⟩, Subtype.ext hσ⟩


/-- The degree map of `K` on the image of an element of the Weil group of `L` is the residue degree times the degree map of `L`. -/
theorem degree_weilHom (w : WeilGroup L) :
    degree K (weilHom K L w) =
      Multiplicative.ofAdd ((residueFinrank K L : ℤ) * Multiplicative.toAdd (degree L w)) := by
  apply injective_zpowersHom_frobenius_inv K
  rw [zpowersHom_apply, zpowersHom_apply, ← toResidue_eq_zpow_degree]
  apply toRingAutK_injective K
  rw [toRingAutK_toResidue_weilHom, toResidue_eq_zpow_degree, toAdd_ofAdd, inv_zpow', inv_zpow',
    toRingAutL_frobenius_zpow, mul_neg]

/-- The residue degree defined by the degree map is the degree of the residue field extension. -/
theorem residueDegree_eq_residueFinrank : residueDegree K L = residueFinrank K L := by
  have h : (restrictSubgroup K L).map (degree K) =
      Subgroup.zpowers (Multiplicative.ofAdd (residueFinrank K L : ℤ)) := by
    rw [← range_weilHom, ← MonoidHom.range_comp]
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      refine Subgroup.mem_zpowers_iff.mpr ⟨Multiplicative.toAdd (degree L w), ?_⟩
      rw [MonoidHom.comp_apply, degree_weilHom, ← ofAdd_zsmul, smul_eq_mul, mul_comm]
    · intro hx
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
      obtain ⟨w, hw⟩ := degree_surjective L (Multiplicative.ofAdd k)
      refine ⟨w, ?_⟩
      rw [MonoidHom.comp_apply, degree_weilHom, hw, toAdd_ofAdd, ← ofAdd_zsmul, smul_eq_mul,
        mul_comm]
  rw [residueDegree, h, index_zpowers_ofAdd, Int.natAbs_natCast]

end Langlands.WeilGroup

