import Langlands.WeilGroup.Dense

/-!
# The abelianization of the Weil group

Let $G_K$ be the absolute Galois group of $K$ and let $W_K \subseteq G_K$ be the Weil group. This file studies the map $W_K^{ab} \to G_K^{ab}$ induced by the inclusion.

* `Langlands.WeilGroup.toGaloisAb` is the map $W_K^{ab} \to G_K^{ab}$. It is continuous.
* `Langlands.WeilGroup.topologicalClosure_commutator_eq_comap` says that the closure of $[W_K, W_K]$ in $W_K$ is the trace on $W_K$ of the closure of $[G_K, G_K]$ in $G_K$.
* `Langlands.WeilGroup.topologicalClosure_commutator_le_map_inertia` says that the closure of $[G_K, G_K]$ in $G_K$ lies in the inertia subgroup of $W_K$.
* `Langlands.WeilGroup.toGaloisAb_injective` says that $W_K^{ab} \to G_K^{ab}$ is injective.
* `Langlands.WeilGroup.mem_range_toGaloisAb` describes the range.

## Implementation notes

The density of $W_K$ in $G_K$ is the lemma `denseRange_toGalois` of `Langlands.WeilGroup.Dense`. The results `commutator_le_topologicalClosure_map`, `topologicalClosure_commutator_eq`, `topologicalClosure_commutator_le_map_inertia`, `topologicalClosure_commutator_le_weilSubgroup`, `topologicalClosure_commutator_eq_comap`, `ker_mk_comp_toGalois` and `toGaloisAb_injective` use it.

The topology of $W_K$ is finer than the topology induced from $G_K$. The proofs use the fact that the two topologies agree on the inertia subgroup, which contains $[W_K, W_K]$.
-/

namespace Langlands

open LocalField

open scoped Topology Pointwise commutatorElement

universe u

variable (K : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

namespace WeilGroup

/-! ### The map to the abelianization of the Galois group -/

theorem commutator_le_comap :
    commutator (WeilGroup K) ≤ (commutator (Field.absoluteGaloisGroup K)).comap (toGalois K) := by
  rw [← Subgroup.map_le_iff_le_comap, commutator_def, commutator_def, Subgroup.map_commutator]
  exact Subgroup.commutator_mono le_top le_top

/-- The closure of $[W_K, W_K]$ in $W_K$ maps into the closure of $[G_K, G_K]$ in $G_K$. -/
theorem topologicalClosure_commutator_le_comap :
    (commutator (WeilGroup K)).topologicalClosure ≤
      (commutator (Field.absoluteGaloisGroup K)).topologicalClosure.comap (toGalois K) :=
  Subgroup.topologicalClosure_minimal _
    ((commutator_le_comap K).trans (Subgroup.comap_mono (Subgroup.le_topologicalClosure _)))
    ((Subgroup.isClosed_topologicalClosure _).preimage (continuous_toGalois K))

/-- The map $W_K^{ab} \to G_K^{ab}$ induced by the inclusion $W_K \to G_K$. -/
noncomputable def toGaloisAb : Ab K →* Field.absoluteGaloisGroupAbelianization K :=
  QuotientGroup.map _ _ (toGalois K) (topologicalClosure_commutator_le_comap K)

theorem toGaloisAb_mk (w : WeilGroup K) :
    toGaloisAb K (QuotientGroup.mk w) = QuotientGroup.mk (toGalois K w) :=
  rfl

theorem continuous_toGaloisAb : Continuous (toGaloisAb K) :=
  (QuotientGroup.isQuotientMap_mk _).continuous_iff.mpr
    (QuotientGroup.continuous_mk.comp (continuous_toGalois K))

/-- The map $W_K^{ab} \to G_K^{ab}$ as a continuous group homomorphism. -/
noncomputable def toGaloisAbContinuous :
    Ab K →ₜ* Field.absoluteGaloisGroupAbelianization K where
  toMonoidHom := toGaloisAb K
  continuous_toFun := continuous_toGaloisAb K

/-! ### The commutator subgroup lies in the inertia subgroup -/

theorem toResidue_mem_zpowers (w : WeilGroup K) :
    toResidue K w ∈ Subgroup.zpowers (LocalField.frobenius K) := by
  obtain ⟨s, hs, hsw⟩ := Subgroup.mem_map.mp w.2
  have h : Subgroup.inclusion (weilSubgroup_le_stabilizer K) w = s := Subtype.ext hsw.symm
  change residueHom K (Subgroup.inclusion (weilSubgroup_le_stabilizer K) w) ∈ _
  rw [h]
  exact hs

/-- The commutator subgroup of $W_K$ lies in the inertia subgroup, because $W_K / I_K$ embeds in the abelian group generated by the Frobenius. -/
theorem commutator_le_inertia : commutator (WeilGroup K) ≤ inertia K := by
  rw [commutator_def, Subgroup.commutator_le]
  intro a _ b _
  rw [inertia, MonoidHom.mem_ker, map_commutatorElement]
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (toResidue_mem_zpowers K a)
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (toResidue_mem_zpowers K b)
  rw [← hm, ← hn, commutatorElement_eq_one_iff_commute]
  exact (Commute.refl _).zpow_zpow m n

/-! ### Approximation in the Krull topology -/

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- In the Krull topology, the elements near $\sigma$ agree with $\sigma$ at a given point. -/
theorem eventually_smul_eq (σ : Field.absoluteGaloisGroup K) (x : AlgebraicClosure K) :
    ∀ᶠ τ in 𝓝 σ, τ • x = σ • x := by
  let E : IntermediateField K (AlgebraicClosure K) := IntermediateField.adjoin K {x}
  have : FiniteDimensional K E :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x)
  let H : Subgroup (Field.absoluteGaloisGroup K) := E.fixingSubgroup
  have hH : IsOpen (H : Set (Field.absoluteGaloisGroup K)) := E.fixingSubgroup_isOpen
  have hU : IsOpen ((fun τ : Field.absoluteGaloisGroup K => σ⁻¹ * τ) ⁻¹'
      (H : Set (Field.absoluteGaloisGroup K))) :=
    hH.preimage (continuous_const.mul continuous_id)
  have hσ : σ ∈ (fun τ : Field.absoluteGaloisGroup K => σ⁻¹ * τ) ⁻¹'
      (H : Set (Field.absoluteGaloisGroup K)) := by
    simp only [Set.mem_preimage, inv_mul_cancel, SetLike.mem_coe]
    exact one_mem _
  filter_upwards [hU.mem_nhds hσ] with τ hτ
  have h := (IntermediateField.mem_fixingSubgroup_iff _ _).mp hτ x
    (IntermediateField.mem_adjoin_simple_self K x)
  change (σ⁻¹ * τ) • x = x at h
  rw [mul_smul, inv_smul_eq_iff] at h
  exact h

/-- If an element of $W_K$ lies in the closure in $G_K$ of $[W_K, W_K]$, then it lies in the inertia subgroup. -/
theorem toResidue_eq_one_of_mem_closure (w : WeilGroup K)
    (hw : toGalois K w ∈
      closure (toGalois K '' (commutator (WeilGroup K) : Set (WeilGroup K)))) :
    toResidue K w = 1 := by
  refine AlgEquiv.ext fun y => ?_
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨_, hτ, v, hv, rfl⟩ :=
    mem_closure_iff_nhds.mp hw _ (eventually_smul_eq K (toGalois K w) (x : AlgebraicClosure K))
  have hv1 : toResidue K v = 1 := commutator_le_inertia K hv
  have hvx : toResidue K v (Ideal.Quotient.mk (prime K) x) = Ideal.Quotient.mk (prime K) x := by
    rw [hv1]
    rfl
  have heq : (Subgroup.inclusion (weilSubgroup_le_stabilizer K) v) • x =
      (Subgroup.inclusion (weilSubgroup_le_stabilizer K) w) • x :=
    Subtype.ext hτ
  change Ideal.Quotient.mk (prime K) ((Subgroup.inclusion (weilSubgroup_le_stabilizer K) w) • x) =
    Ideal.Quotient.mk (prime K) x
  rw [← heq]
  exact hvx

/-- An element of $G_K$ in the closure of $[W_K, W_K]$ maps $\bar{\mathfrak{m}}$ into itself. -/
theorem smul_mem_prime_of_mem_closure (c : Field.absoluteGaloisGroup K)
    (hc : c ∈ ((commutator (WeilGroup K)).map (toGalois K)).topologicalClosure)
    (x : integers K) (hx : x ∈ prime K) : c • x ∈ prime K := by
  rw [← SetLike.mem_coe, Subgroup.topologicalClosure_coe, Subgroup.coe_map] at hc
  obtain ⟨_, hτ, v, -, rfl⟩ :=
    mem_closure_iff_nhds.mp hc _ (eventually_smul_eq K c (x : AlgebraicClosure K))
  have heq : c • x = (Subgroup.inclusion (weilSubgroup_le_stabilizer K) v) • x :=
    Subtype.ext hτ.symm
  rw [heq]
  have hs := (Subgroup.inclusion (weilSubgroup_le_stabilizer K) v).2
  rw [MulAction.mem_stabilizer_iff] at hs
  have h := Ideal.smul_mem_pointwise_smul
    ((Subgroup.inclusion (weilSubgroup_le_stabilizer K) v : _) : Field.absoluteGaloisGroup K)
    x (prime K) hx
  rw [hs] at h
  exact h

/-- An element of $G_K$ in the closure of $[W_K, W_K]$ fixes $\bar{\mathfrak{m}}$. -/
theorem mem_stabilizer_of_mem_closure (c : Field.absoluteGaloisGroup K)
    (hc : c ∈ ((commutator (WeilGroup K)).map (toGalois K)).topologicalClosure) :
    c ∈ MulAction.stabilizer (Field.absoluteGaloisGroup K) (prime K) := by
  rw [MulAction.mem_stabilizer_iff]
  ext x
  rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem]
  constructor
  · intro h
    have h' := smul_mem_prime_of_mem_closure K c hc _ h
    rwa [smul_inv_smul] at h'
  · exact smul_mem_prime_of_mem_closure K c⁻¹ (inv_mem hc) x

/-- The closure in $G_K$ of $[W_K, W_K]$ lies in the image of the inertia subgroup of $W_K$. In particular it lies in the Weil subgroup. -/
theorem topologicalClosure_map_commutator_le_map_inertia :
    ((commutator (WeilGroup K)).map (toGalois K)).topologicalClosure ≤
      (inertia K).map (toGalois K) := by
  intro c hc
  let s : MulAction.stabilizer (Field.absoluteGaloisGroup K) (prime K) :=
    ⟨c, mem_stabilizer_of_mem_closure K c hc⟩
  have hs : residueHom K s = 1 := by
    refine AlgEquiv.ext fun y => ?_
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← SetLike.mem_coe, Subgroup.topologicalClosure_coe, Subgroup.coe_map] at hc
    obtain ⟨_, hτ, v, hv, rfl⟩ :=
      mem_closure_iff_nhds.mp hc _ (eventually_smul_eq K c (x : AlgebraicClosure K))
    have hv1 : toResidue K v = 1 := commutator_le_inertia K hv
    have hvx : toResidue K v (Ideal.Quotient.mk (prime K) x) =
        Ideal.Quotient.mk (prime K) x := by
      rw [hv1]
      rfl
    have heq : (Subgroup.inclusion (weilSubgroup_le_stabilizer K) v) • x = s • x :=
      Subtype.ext hτ
    change Ideal.Quotient.mk (prime K) (s • x) = Ideal.Quotient.mk (prime K) x
    rw [← heq]
    exact hvx
  have hW : c ∈ weilSubgroup K :=
    Subgroup.mem_map.mpr ⟨s, by rw [Subgroup.mem_comap, hs]; exact one_mem _, rfl⟩
  refine ⟨⟨c, hW⟩, ?_, rfl⟩
  have h : Subgroup.inclusion (weilSubgroup_le_stabilizer K) (⟨c, hW⟩ : WeilGroup K) = s := rfl
  change residueHom K (Subgroup.inclusion (weilSubgroup_le_stabilizer K) _) = 1
  rw [h, hs]

/-- The neighbourhoods of a point of $W_K$. -/
theorem nhds_eq (w : WeilGroup K) :
    𝓝 w = Filter.comap (toGalois K) (𝓝 (toGalois K w)) ⊓
      Filter.comap (toResidue K) (pure (toResidue K w)) := by
  let t : TopologicalSpace (residueFieldBar K ≃ₐ[residueField K] residueFieldBar K) := ⊥
  have : DiscreteTopology (residueFieldBar K ≃ₐ[residueField K] residueFieldBar K) := ⟨rfl⟩
  have h := @nhds_inf _ (TopologicalSpace.induced (toGalois K) inferInstance)
    (TopologicalSpace.induced (toResidue K) t) w
  rw [nhds_induced, nhds_induced,
    nhds_discrete (residueFieldBar K ≃ₐ[residueField K] residueFieldBar K)] at h
  exact h

/-- An element of $W_K$ whose image lies in the closure in $G_K$ of $[W_K, W_K]$ lies in the closure in $W_K$ of $[W_K, W_K]$. -/
theorem mem_topologicalClosure_commutator_of_mem_closure (w : WeilGroup K)
    (hw : toGalois K w ∈
      closure (toGalois K '' (commutator (WeilGroup K) : Set (WeilGroup K)))) :
    w ∈ (commutator (WeilGroup K)).topologicalClosure := by
  have hw1 := toResidue_eq_one_of_mem_closure K w hw
  rw [← SetLike.mem_coe, Subgroup.topologicalClosure_coe, mem_closure_iff_nhds]
  intro t ht
  rw [nhds_eq, Filter.mem_inf_iff] at ht
  obtain ⟨t₁, ht₁, t₂, ht₂, rfl⟩ := ht
  obtain ⟨U, hU, hUt⟩ := Filter.mem_comap.mp ht₁
  obtain ⟨V, hV, hVt⟩ := Filter.mem_comap.mp ht₂
  obtain ⟨_, hτ, v, hv, rfl⟩ := mem_closure_iff_nhds.mp hw U hU
  refine ⟨v, ⟨hUt hτ, hVt ?_⟩, hv⟩
  change toResidue K v ∈ V
  rw [commutator_le_inertia K hv, ← hw1]
  exact Filter.mem_pure.mp hV

/-! ### Injectivity -/

/-- The commutator subgroup of $G_K$ lies in the closure in $G_K$ of $[W_K, W_K]$. This uses the density of $W_K$ and the continuity of the commutator map. -/
theorem commutator_le_topologicalClosure_map :
    commutator (Field.absoluteGaloisGroup K) ≤
      ((commutator (WeilGroup K)).map (toGalois K)).topologicalClosure := by
  rw [commutator_def, Subgroup.commutator_le]
  intro g _ h _
  let S := ((commutator (WeilGroup K)).map (toGalois K)).topologicalClosure
  let f : Field.absoluteGaloisGroup K × Field.absoluteGaloisGroup K →
    Field.absoluteGaloisGroup K := fun p => ⁅p.1, p.2⁆
  have hc : Continuous f := by
    simp only [f, commutatorElement_def]
    fun_prop
  have hd : DenseRange (Prod.map (toGalois K) (toGalois K)) :=
    (denseRange_toGalois K).prodMap (denseRange_toGalois K)
  have key : ∀ p, f p ∈ S := fun p =>
    hd.induction_on (p := fun p => f p ∈ S) p
      ((Subgroup.isClosed_topologicalClosure _).preimage hc)
      (fun a => Subgroup.le_topologicalClosure _ (by
        change ⁅toGalois K a.1, toGalois K a.2⁆ ∈ (commutator (WeilGroup K)).map (toGalois K)
        rw [← map_commutatorElement]
        exact Subgroup.mem_map_of_mem _
          (Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _))))
  exact key (g, h)

/-- The closure in $G_K$ of $[G_K, G_K]$ equals the closure in $G_K$ of $[W_K, W_K]$. -/
theorem topologicalClosure_commutator_eq :
    (commutator (Field.absoluteGaloisGroup K)).topologicalClosure =
      ((commutator (WeilGroup K)).map (toGalois K)).topologicalClosure :=
  le_antisymm
    (Subgroup.topologicalClosure_minimal _ (commutator_le_topologicalClosure_map K)
      (Subgroup.isClosed_topologicalClosure _))
    (Subgroup.topologicalClosure_mono
      (Subgroup.map_le_iff_le_comap.mpr (commutator_le_comap K)))

/-- The closure in $G_K$ of $[G_K, G_K]$ lies in the image of the inertia subgroup of $W_K$. In particular it lies in the Weil subgroup. -/
theorem topologicalClosure_commutator_le_map_inertia :
    (commutator (Field.absoluteGaloisGroup K)).topologicalClosure ≤
      (inertia K).map (toGalois K) := by
  rw [topologicalClosure_commutator_eq]
  exact topologicalClosure_map_commutator_le_map_inertia K

theorem topologicalClosure_commutator_le_weilSubgroup :
    (commutator (Field.absoluteGaloisGroup K)).topologicalClosure ≤ weilSubgroup K :=
  (topologicalClosure_commutator_le_map_inertia K).trans (Subgroup.map_subtype_le _)

/-- The closure in $W_K$ of $[W_K, W_K]$ is the trace on $W_K$ of the closure in $G_K$ of $[G_K, G_K]$. -/
theorem topologicalClosure_commutator_eq_comap :
    (commutator (WeilGroup K)).topologicalClosure =
      (commutator (Field.absoluteGaloisGroup K)).topologicalClosure.comap (toGalois K) := by
  refine le_antisymm (topologicalClosure_commutator_le_comap K) fun w hw => ?_
  rw [Subgroup.mem_comap, topologicalClosure_commutator_eq, ← SetLike.mem_coe,
    Subgroup.topologicalClosure_coe, Subgroup.coe_map] at hw
  exact mem_topologicalClosure_commutator_of_mem_closure K w hw

/-- The kernel of $W_K \to G_K^{ab}$ is the closure in $W_K$ of $[W_K, W_K]$. -/
theorem ker_mk_comp_toGalois :
    ((QuotientGroup.mk' (commutator (Field.absoluteGaloisGroup K)).topologicalClosure).comp
      (toGalois K)).ker = (commutator (WeilGroup K)).topologicalClosure := by
  rw [topologicalClosure_commutator_eq_comap, ← MonoidHom.comap_ker, QuotientGroup.ker_mk']

/-- The map $W_K^{ab} \to G_K^{ab}$ is injective. -/
theorem toGaloisAb_injective : Function.Injective (toGaloisAb K) := by
  rw [injective_iff_map_eq_one]
  intro a ha
  induction a using QuotientGroup.induction_on with
  | H w =>
    rw [toGaloisAb_mk, QuotientGroup.eq_one_iff] at ha
    rw [QuotientGroup.eq_one_iff, topologicalClosure_commutator_eq_comap]
    exact ha

/-! ### Separation and range -/

instance isClosed_topologicalClosure_commutator :
    IsClosed ((commutator (WeilGroup K)).topologicalClosure : Set (WeilGroup K)) :=
  Subgroup.isClosed_topologicalClosure _

/-- The topological abelianization of $W_K$ is Hausdorff. -/
instance t2Space : T2Space (Ab K) :=
  inferInstance

/-- An element of $G_K^{ab}$ is in the range of $W_K^{ab} \to G_K^{ab}$ if and only if it is the class of an element of the Weil subgroup. -/
theorem mem_range_toGaloisAb (x : Field.absoluteGaloisGroupAbelianization K) :
    x ∈ (toGaloisAb K).range ↔ ∃ g ∈ weilSubgroup K, QuotientGroup.mk g = x := by
  constructor
  · rintro ⟨a, rfl⟩
    induction a using QuotientGroup.induction_on with
    | H w => exact ⟨toGalois K w, w.2, rfl⟩
  · rintro ⟨g, hg, rfl⟩
    exact ⟨QuotientGroup.mk (⟨g, hg⟩ : weilSubgroup K), rfl⟩

end WeilGroup

end Langlands
