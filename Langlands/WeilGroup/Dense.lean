/-!
# The density of the Weil group

Let $K$ be a nonarchimedean local field. This file proves facts about `integers K`, the integral closure of $\mathcal{O}_K$ in $\bar K$, and its residue field `residueFieldBar K`.

* `isLocalRing_integers`: `integers K` is a local ring. So `prime K` is its only maximal ideal.
* `stabilizer_eq_top`: every element of $G_K$ fixes `prime K`.
* `residueHom_mk`: the action of the stabilizer on residues.
* `exists_isRoot_lift`: a root of the reduction of a monic polynomial lifts to a root.
* `exists_pow_card_pow_eq_self_lift`: every element of $\bar k$ is the residue of a root of $X^{q^m} - X$ for some $m \ge 1$.
* `compactSpace_of_normal`: the Galois group of a normal extension is compact. In particular $G_K$ is compact, also in characteristic $p$, where $\bar K / K$ is not separable.
* `residueAut`: the map $G_K \to \mathrm{Gal}(\bar k / k)$. It is continuous (`continuous_residueAut`), surjective (`residueAut_surjective`) and open (`isOpenMap_residueAut`).
* `dense_zpowers_frobenius`: the powers of the Frobenius are dense in $\mathrm{Gal}(\bar k / k)$.
* `Langlands.WeilGroup.denseRange_toGalois`: the Weil group is dense in $G_K$.

## Implementation notes

Compactness of $G_K$: restriction to the separable closure $K^{sep}$ is a bijection onto $\mathrm{Gal}(K^{sep}/K)$, which is compact, and its inverse is continuous because every element of $\bar K$ has a $p$-power in $K^{sep}$. The map to $\mathrm{Gal}(\bar k / k)$ has dense image by a minimal polynomial argument, and closed image by compactness, so it is surjective; a continuous surjective homomorphism from a compact group to a Hausdorff group is open. The Weil group is the preimage of the dense subgroup generated by the Frobenius under this open map.

The proof that `integers K` is local does not use Hensel's lemma. It puts on $K$ the norm of its valuation and uses the spectral norm on $\bar K$, which is multiplicative because $K$ is complete. An element of $\bar K$ is integral over $\mathcal{O}_K$ if and only if its spectral norm is at most one. The units of `integers K` are the elements of spectral norm one. The ultrametric inequality then shows that the nonunits form an ideal.
-/

open Polynomial

open scoped Pointwise

namespace Langlands.LocalField

section Abstract

variable {K L R : Type*} [NontriviallyNormedField K]
  [Field L] [Algebra K L] [Algebra.IsAlgebraic K L]
  [CommRing R] [Algebra R K] [Algebra R L] [IsScalarTower R K L]

/-- An element integral over a subring of the closed unit ball has spectral norm at most one. -/
theorem spectralNorm_le_one_of_isIntegral [IsUltrametricDist K]
    (hR : ∀ r : R, ‖algebraMap R K r‖ ≤ 1) {x : L} (hx : IsIntegral R x) :
    spectralNorm K L x ≤ 1 := by
  obtain ⟨p, hp, hpx⟩ := hx
  have hq : (p.map (algebraMap R K)).Monic := hp.map _
  have hqx : aeval x (p.map (algebraMap R K)) = 0 := by
    rw [aeval_map_algebraMap]; exact hpx
  calc spectralNorm K L x = spectralAlgNorm K L x := rfl
    _ ≤ spectralValue (p.map (algebraMap R K)) :=
        norm_root_le_spectralValue spectralAlgNorm_isPowMul isNonarchimedean_spectralNorm
          hq hqx
    _ ≤ 1 := (spectralValue_le_one_iff hq).mpr fun n => by rw [coeff_map]; exact hR _

/-- An element of spectral norm at most one is integral over the closed unit ball. -/
theorem isIntegral_of_spectralNorm_le_one
    (hR : ∀ x : K, ‖x‖ ≤ 1 → x ∈ (algebraMap R K).range) {x : L}
    (hx : spectralNorm K L x ≤ 1) : IsIntegral R x := by
  have hm : (minpoly K x).Monic := minpoly.monic (Algebra.IsIntegral.isIntegral x)
  have hc := (spectralValue_le_one_iff hm).mp hx
  have hl : minpoly K x ∈ Polynomial.lifts (algebraMap R K) :=
    (Polynomial.lifts_iff_coeff_lifts _).mpr fun n => hR _ (hc n)
  obtain ⟨q, hq, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl hm
  refine ⟨q, hqm, ?_⟩
  rw [← aeval_def, ← aeval_map_algebraMap K, hq]
  exact minpoly.aeval K x

/-- Let `K` be complete and let the closed unit ball of `K` be the image of `R`. Then the units of the integral closure of `R` in an algebraic extension `L` are the elements of spectral norm one. -/
theorem isUnit_iff_spectralNorm_eq_one [IsUltrametricDist K] [CompleteSpace K]
    (hR : ∀ x : K, ‖x‖ ≤ 1 ↔ x ∈ (algebraMap R K).range) (a : integralClosure R L) :
    IsUnit a ↔ spectralNorm K L (a : L) = 1 := by
  have hle : ∀ b : integralClosure R L, spectralNorm K L (b : L) ≤ 1 := fun b =>
    spectralNorm_le_one_of_isIntegral (fun r => (hR _).mpr ⟨r, rfl⟩) b.2
  constructor
  · intro ha
    obtain ⟨b, hab⟩ := ha.exists_right_inv
    have h1 : (a : L) * (b : L) = 1 := congrArg Subtype.val hab
    have h2 : spectralAlgNorm K L (a : L) * spectralAlgNorm K L (b : L) = 1 := by
      rw [← spectralAlgNorm_mul, h1, spectralAlgNorm_one]
    have ha1 := hle a
    have hb1 := hle b
    have hb0 := spectralNorm_nonneg (K := K) (b : L)
    have ha0 := spectralNorm_nonneg (K := K) (a : L)
    change spectralNorm K L (a : L) * spectralNorm K L (b : L) = 1 at h2
    nlinarith
  · intro ha
    have ha0 : (a : L) ≠ 0 := by
      intro h0
      rw [h0, spectralNorm_zero] at ha
      exact zero_ne_one ha
    have hinv : spectralNorm K L ((a : L)⁻¹) ≤ 1 := by
      have h2 : spectralAlgNorm K L (a : L) * spectralAlgNorm K L ((a : L)⁻¹) = 1 := by
        rw [← spectralAlgNorm_mul, mul_inv_cancel₀ ha0, spectralAlgNorm_one]
      change spectralNorm K L (a : L) * spectralNorm K L ((a : L)⁻¹) = 1 at h2
      rw [ha, one_mul] at h2
      exact h2.le
    let b : integralClosure R L :=
      ⟨(a : L)⁻¹, isIntegral_of_spectralNorm_le_one (fun x hx => (hR x).mp hx) hinv⟩
    exact IsUnit.of_mul_eq_one (a := a) b (Subtype.ext (mul_inv_cancel₀ ha0))

/-- If the closed unit ball of a complete nonarchimedean field `K` is the image of `R`, then the integral closure of `R` in an algebraic extension of `K` is a local ring. -/
theorem isLocalRing_integralClosure [IsUltrametricDist K] [CompleteSpace K]
    (hR : ∀ x : K, ‖x‖ ≤ 1 ↔ x ∈ (algebraMap R K).range) :
    IsLocalRing (integralClosure R L) := by
  have hle : ∀ b : integralClosure R L, spectralNorm K L (b : L) ≤ 1 := fun b =>
    spectralNorm_le_one_of_isIntegral (fun r => (hR _).mpr ⟨r, rfl⟩) b.2
  have hlt : ∀ b : integralClosure R L, b ∈ nonunits _ → spectralNorm K L (b : L) < 1 :=
    fun b hb => lt_of_le_of_ne (hle b) fun h => hb ((isUnit_iff_spectralNorm_eq_one hR b).mpr h)
  refine IsLocalRing.of_nonunits_add fun a b ha hb hab => ?_
  have h := (isUnit_iff_spectralNorm_eq_one hR (a + b)).mp hab
  have hna : spectralNorm K L ((a : L) + (b : L)) ≤
      max (spectralNorm K L (a : L)) (spectralNorm K L (b : L)) :=
    isNonarchimedean_spectralNorm _ _
  have : spectralNorm K L ((a + b : integralClosure R L) : L) < 1 :=
    lt_of_le_of_lt hna (max_lt (hlt a ha) (hlt b hb))
  exact absurd h this.ne

end Abstract

section Compact

variable (F E : Type*) [Field F] [Field E] [Algebra F E] [Normal F E]

/-- Some power `x ^ p ^ n` of an element of a normal extension lies in the separable closure. -/
theorem exists_pow_mem_separableClosure (p : ℕ) [ExpChar F p] (x : E) :
    ∃ n : ℕ, x ^ p ^ n ∈ separableClosure F E := by
  have : ExpChar (separableClosure F E) p :=
    expChar_of_injective_algebraMap (algebraMap F _).injective p
  obtain ⟨n, y, hy⟩ :=
    (isPurelyInseparable_iff_pow_mem (separableClosure F E) p).mp inferInstance x
  refine ⟨n, ?_⟩
  rw [← hy]
  exact y.2

omit [Normal F E] in
/-- An automorphism that fixes `x ^ p ^ n` fixes `x`. -/
theorem eq_of_pow_eq (p : ℕ) [ExpChar F p] (g : Gal(E/F)) (x : E) (n : ℕ)
    (h : g (x ^ p ^ n) = x ^ p ^ n) : g x = x := by
  have : ExpChar E p := expChar_of_injective_algebraMap (algebraMap F E).injective p
  apply iterateFrobenius_inj E p n
  rw [iterateFrobenius_def, iterateFrobenius_def, ← map_pow, h]

theorem restrictNormalHom_separableClosure_injective :
    Function.Injective (AlgEquiv.restrictNormalHom (F := F) (K₁ := E) (separableClosure F E)) := by
  rw [injective_iff_map_eq_one]
  intro g hg
  obtain ⟨p, hp⟩ := ExpChar.exists F
  ext x
  obtain ⟨n, hn⟩ := exists_pow_mem_separableClosure F E p x
  refine eq_of_pow_eq F E p g x n ?_
  have h := AlgEquiv.restrictNormalHom_apply (separableClosure F E) g ⟨_, hn⟩
  rw [hg] at h
  exact h.symm

/-- The Galois group of a normal extension is compact. -/
instance compactSpace_of_normal : CompactSpace Gal(E/F) := by
  let S := separableClosure F E
  let r := AlgEquiv.restrictNormalHom (F := F) (K₁ := E) S
  have hr : Function.Bijective r :=
    ⟨restrictNormalHom_separableClosure_injective F E, AlgEquiv.restrictNormalHom_surjective E⟩
  let e : Gal(S/F) ≃* Gal(E/F) := (MulEquiv.ofBijective r hr).symm
  have hre : ∀ h, r (e h) = h := fun h => (MulEquiv.ofBijective r hr).apply_symm_apply h
  have hc : Continuous e := by
    apply continuous_of_continuousAt_one e.toMonoidHom
    rw [ContinuousAt, map_one]
    intro U hU
    obtain ⟨L, hL, hLU⟩ := (krullTopology_mem_nhds_one_iff F E U).mp hU
    obtain ⟨p, hp⟩ := ExpChar.exists F
    let b := Module.finBasis F L
    have hb := fun i => exists_pow_mem_separableClosure F E p (b i : E)
    choose n hn using hb
    let T : Set S := Set.range fun i => (⟨(b i : E) ^ p ^ n i, hn i⟩ : S)
    have hT : Finite T := Set.finite_range _
    have hL' : FiniteDimensional F (IntermediateField.adjoin F T) :=
      IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
    refine (krullTopology_mem_nhds_one_iff F S _).mpr ⟨_, hL', fun h hh => hLU ?_⟩
    change e h ∈ L.fixingSubgroup
    rw [IntermediateField.mem_fixingSubgroup_iff]
    have hfix : ∀ i, (e h) (b i : E) = b i := fun i => by
      refine eq_of_pow_eq F E p _ _ (n i) ?_
      have h1 := AlgEquiv.restrictNormalHom_apply S (e h) ⟨_, hn i⟩
      rw [hre] at h1
      rw [← h1]
      have h2 := (IntermediateField.mem_fixingSubgroup_iff _ _).mp hh _
        (IntermediateField.subset_adjoin F T ⟨i, rfl⟩)
      exact congrArg Subtype.val h2
    have hlin : (e h).toLinearMap.comp L.val.toLinearMap = L.val.toLinearMap :=
      b.ext fun i => hfix i
    intro x hx
    exact LinearMap.congr_fun hlin ⟨x, hx⟩
  exact e.surjective.compactSpace hc

end Compact

section Krull

variable {F L : Type*} [Field F] [Field L] [Algebra F L]

/-- A set of automorphisms is dense in the Krull topology if it approximates every automorphism on every finite subextension. -/
theorem dense_of_forall_exists_eqOn (A : Set Gal(L/F))
    (h : ∀ τ : Gal(L/F), ∀ E : IntermediateField F L, FiniteDimensional F E →
      ∃ a ∈ A, ∀ x ∈ E, a x = τ x) : Dense A := by
  intro τ
  rw [mem_closure_iff_nhds]
  intro V hV
  rw [← map_mul_left_nhds_one τ, Filter.mem_map] at hV
  obtain ⟨E, hE, hsub⟩ := (krullTopology_mem_nhds_one_iff F L _).mp hV
  obtain ⟨a, ha, hax⟩ := h τ E hE
  refine ⟨a, ?_, ha⟩
  have hmem : τ⁻¹ * a ∈ E.fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    rw [AlgEquiv.mul_apply, hax x hx]
    exact τ.symm_apply_apply x
  have := hsub hmem
  simpa using this

end Krull

open ValuativeRel

variable (K : Type*) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

/-- The integral closure of `𝒪[K]` in `AlgebraicClosure K` is a local ring. The proof puts the norm of the valuation on `K` and uses the spectral norm on the algebraic closure. -/
instance isLocalRing_integers : IsLocalRing (integers K) := by
  let := IsTopologicalAddGroup.rightUniformSpace K
  have := isUniformAddGroup_of_addCommGroup (G := K)
  let hr : (Valued.v (R := K)).RankOne :=
  { hom' := IsRankLeOne.nonempty.some.emb (R := K).comp MonoidWithZeroHom.ValueGroup₀.embedding
    strictMono' := IsRankLeOne.nonempty.some.strictMono.comp
        MonoidWithZeroHom.ValueGroup₀.embedding_strictMono }
  let : NontriviallyNormedField K := Valued.toNontriviallyNormedField K (ValueGroupWithZero K)
  have : IsUltrametricDist K := inferInstance
  have : CompleteSpace K := inferInstance
  refine isLocalRing_integralClosure (K := K) fun x => ?_
  rw [Valued.toNormedField.norm_le_one_iff]
  constructor
  · intro hx
    exact ⟨⟨x, hx⟩, rfl⟩
  · rintro ⟨y, rfl⟩
    exact y.2

/-- The chosen prime `prime K` is the maximal ideal of the local ring `integers K`. -/
theorem prime_eq_maximalIdeal : prime K = IsLocalRing.maximalIdeal (integers K) :=
  IsLocalRing.eq_maximalIdeal inferInstance

/-- Every maximal ideal of `integers K` is `prime K`. -/
theorem eq_prime_of_isMaximal (P : Ideal (integers K)) [P.IsMaximal] : P = prime K :=
  (IsLocalRing.eq_maximalIdeal inferInstance).trans (prime_eq_maximalIdeal K).symm

/-- Every element of the absolute Galois group fixes the prime `prime K`. -/
theorem smul_prime (σ : Field.absoluteGaloisGroup K) : σ • prime K = prime K := by
  have key : ∀ τ : Field.absoluteGaloisGroup K, τ • prime K ≤ prime K := fun τ => by
    have h := IsLocalRing.le_maximalIdeal (Ideal.IsPrime.smul (I := prime K) τ).ne_top
    rwa [← prime_eq_maximalIdeal] at h
  refine le_antisymm (key σ) ?_
  rw [Ideal.subset_pointwise_smul_iff]
  exact key σ⁻¹

/-- The stabilizer of `prime K` is the whole absolute Galois group. -/
theorem stabilizer_eq_top :
    MulAction.stabilizer (Field.absoluteGaloisGroup K) (prime K) = ⊤ :=
  eq_top_iff.mpr fun σ _ => smul_prime K σ

/-- Every element of the absolute Galois group lies in the stabilizer of `prime K`. -/
theorem mem_stabilizer (σ : Field.absoluteGaloisGroup K) :
    σ ∈ MulAction.stabilizer (Field.absoluteGaloisGroup K) (prime K) :=
  smul_prime K σ

/-- The action of an element of the stabilizer on `residueFieldBar K`, computed on residues. -/
@[simp]
theorem residueHom_mk (σ : MulAction.stabilizer (Field.absoluteGaloisGroup K) (prime K))
    (ζ : integers K) :
    residueHom K σ (Ideal.Quotient.mk (prime K) ζ) =
      Ideal.Quotient.mk (prime K) ((σ : Field.absoluteGaloisGroup K) • ζ) :=
  rfl

omit [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- The action of the absolute Galois group on `integers K` is the action on the algebraic closure. -/
@[simp]
theorem coe_smul_integers (σ : Field.absoluteGaloisGroup K) (ζ : integers K) :
    ((σ • ζ : integers K) : AlgebraicClosure K) =
      (show AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K from σ) (ζ : AlgebraicClosure K) :=
  rfl

open Polynomial in
/-- A root of the reduction of a monic polynomial over `integers K` lifts to a root in `integers K`. The polynomial splits in the algebraic closure, and its roots are integral. -/
theorem exists_isRoot_lift {g : (integers K)[X]} (hg : g.Monic) {x : residueFieldBar K}
    (hx : (g.map (Ideal.Quotient.mk (prime K))).eval x = 0) :
    ∃ ζ : integers K, g.eval ζ = 0 ∧ Ideal.Quotient.mk (prime K) ζ = x := by
  set ι : integers K →+* AlgebraicClosure K := algebraMap (integers K) (AlgebraicClosure K)
  have hι : Function.Injective ι := Subtype.val_injective
  set S := (g.map ι).roots
  have hS : (S.map fun a => X - C a).prod = g.map ι :=
    prod_multiset_X_sub_C_of_monic_of_roots_card_eq (hg.map ι) IsAlgClosed.card_roots_eq_natDegree
  have hint : ∀ a ∈ S, IsIntegral 𝒪[K] a := fun a ha => by
    have h1 : IsIntegral (integers K) a := by
      refine ⟨g, hg, ?_⟩
      have := (mem_roots (hg.map ι).ne_zero).mp ha
      rwa [IsRoot, eval_map] at this
    exact isIntegral_trans a h1
  let T : Multiset (integers K) := S.attach.map fun a => ⟨a.1, hint a.1 a.2⟩
  have hT : T.map ι = S := by
    simp only [T, Multiset.map_map]
    exact Multiset.attach_map_val S
  have hgT : g = (T.map fun ζ => X - C ζ).prod := by
    apply map_injective ι hι
    rw [Polynomial.map_multiset_prod, Multiset.map_map, ← hS, ← hT, Multiset.map_map]
    congr 1
    refine Multiset.map_congr rfl fun ζ _ => ?_
    simp [Function.comp]
  have hprod : (T.map fun ζ => x - Ideal.Quotient.mk (prime K) ζ).prod = 0 := by
    have h2 := congrArg (fun p => (p.map (Ideal.Quotient.mk (prime K))).eval x) hgT
    simp only [Polynomial.map_multiset_prod, eval_multiset_prod, Multiset.map_map] at h2
    rw [← hx, h2]
    congr 1
    refine Multiset.map_congr rfl fun ζ _ => ?_
    simp
  obtain ⟨y, hy, hy0⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp hprod)
  refine ⟨y, ?_, (sub_eq_zero.mp hy0).symm⟩
  apply hι
  rw [map_zero, ← eval₂_hom, ← eval_map]
  have : ι y ∈ S := hT ▸ Multiset.mem_map_of_mem ι hy
  exact (mem_roots (hg.map ι).ne_zero).mp this

/-- Every element of `residueFieldBar K` satisfies `x ^ (q ^ m) = x` for some `m ≥ 1`, where `q` is the order of `residueField K`. -/
theorem exists_pow_card_pow_eq_self (x : residueFieldBar K) :
    ∃ m : ℕ, 0 < m ∧ x ^ (Fintype.card (residueField K) ^ m) = x := by
  let F := IntermediateField.adjoin (residueField K) {x}
  let : Module (residueField K) F := Algebra.toModule
  have : FiniteDimensional (residueField K) F :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x)
  have : Finite F := Module.finite_of_finite (residueField K)
  let := Fintype.ofFinite F
  let y : F := ⟨x, IntermediateField.mem_adjoin_simple_self _ x⟩
  have h := FiniteField.pow_card y
  rw [Module.card_eq_pow_finrank (K := residueField K)] at h
  exact ⟨_, Module.finrank_pos, congrArg Subtype.val h⟩

/-- Every element of `residueFieldBar K` is the residue of an element `ζ` of `integers K` with `ζ ^ (q ^ m) = ζ` for some `m ≥ 1`, where `q` is the order of `residueField K`. -/
theorem exists_pow_card_pow_eq_self_lift (x : residueFieldBar K) :
    ∃ m : ℕ, 0 < m ∧ ∃ ζ : integers K,
      ζ ^ (Fintype.card (residueField K) ^ m) = ζ ∧ Ideal.Quotient.mk (prime K) ζ = x := by
  obtain ⟨m, hm, hx⟩ := exists_pow_card_pow_eq_self K x
  set N := Fintype.card (residueField K) ^ m
  have hN : 1 < N := Nat.one_lt_pow hm.ne' Fintype.one_lt_card
  have hg : (X ^ N - X : (integers K)[X]).Monic := monic_X_pow_sub (degree_X_le.trans_lt (by exact_mod_cast hN))
  obtain ⟨ζ, hζ, hζx⟩ := exists_isRoot_lift K hg (x := x) (by simp [hx])
  refine ⟨m, hm, ζ, ?_, hζx⟩
  simpa [sub_eq_zero] using hζ

/-- Every nonzero element of `residueFieldBar K` is the residue of a root of unity in `integers K` of order dividing `q ^ m - 1` for some `m ≥ 1`, where `q` is the order of `residueField K`. The number `q ^ m - 1` is prime to the residue characteristic. -/
theorem exists_pow_card_pow_sub_one_eq_one_lift {x : residueFieldBar K} (hx : x ≠ 0) :
    ∃ m : ℕ, 0 < m ∧ ∃ ζ : integers K,
      ζ ^ (Fintype.card (residueField K) ^ m - 1) = 1 ∧ Ideal.Quotient.mk (prime K) ζ = x := by
  obtain ⟨m, hm, ζ, hζ, hζx⟩ := exists_pow_card_pow_eq_self_lift K x
  refine ⟨m, hm, ζ, ?_, hζx⟩
  have hζ0 : ζ ≠ 0 := by
    rintro rfl
    exact hx (by rw [← hζx, map_zero])
  have hN : 1 ≤ Fintype.card (residueField K) ^ m := Nat.one_le_pow _ _ Fintype.card_pos
  have h : ζ ^ (Fintype.card (residueField K) ^ m - 1) * ζ = 1 * ζ := by
    rw [← pow_succ, Nat.sub_add_cancel hN, one_mul, hζ]
  exact mul_right_cancel₀ hζ0 h

/-- The number `q ^ m - 1` is prime to the characteristic of `residueField K` for `m ≥ 1`. -/
theorem coprime_card_pow_sub_one (m : ℕ) (hm : 0 < m) :
    Nat.Coprime (ringChar (residueField K)) (Fintype.card (residueField K) ^ m - 1) := by
  obtain ⟨n, hp, hcard⟩ := FiniteField.card (residueField K) (ringChar (residueField K))
  set p := ringChar (residueField K)
  rw [Nat.Prime.coprime_iff_not_dvd hp]
  intro h
  have h1 : p ∣ Fintype.card (residueField K) ^ m := by
    rw [hcard]
    exact dvd_pow (dvd_pow_self p n.ne_zero) hm.ne'
  have hpos : 1 ≤ Fintype.card (residueField K) ^ m := Nat.one_le_pow _ _ Fintype.card_pos
  have h2 : p ∣ 1 := by
    have h3 := Nat.dvd_sub h1 h
    rwa [Nat.sub_sub_self hpos] at h3
  exact hp.one_lt.ne' (Nat.dvd_one.mp h2)

/-! ### The action of the absolute Galois group on the residue field -/

local notation "Γ" => residueFieldBar K ≃ₐ[residueField K] residueFieldBar K

set_option synthInstance.maxHeartbeats 200000 in
/-- A finite subextension of `residueFieldBar K` has an element `y` such that two automorphisms that agree on `y` agree on the subextension. One can take a generator of the multiplicative group. -/
theorem exists_generator (E : IntermediateField (residueField K) (residueFieldBar K))
    [FiniteDimensional (residueField K) E] :
    ∃ y : residueFieldBar K, ∀ σ τ : Γ, σ y = τ y → ∀ x ∈ E, σ x = τ x := by
  set q := Fintype.card (residueField K)
  set m := Module.finrank (residueField K) E
  have hm : 0 < m := Module.finrank_pos
  have hq : 1 < q := Fintype.one_lt_card
  set N := q ^ m - 1
  have hN : 0 < N := Nat.sub_pos_of_lt (Nat.one_lt_pow hm.ne' hq)
  have : NeZero N := ⟨hN.ne'⟩
  obtain ⟨z, hz⟩ := IsCyclic.exists_generator (α := rootsOfUnity N (residueFieldBar K))
  refine ⟨((z : (residueFieldBar K)ˣ) : residueFieldBar K), fun σ τ hστ x hx => ?_⟩
  have : Finite E := Module.finite_of_finite (residueField K)
  let _ := Fintype.ofFinite E
  have hxq : x ^ (q ^ m) = x := by
    have h := FiniteField.pow_card (⟨x, hx⟩ : E)
    rw [Module.card_eq_pow_finrank (K := residueField K)] at h
    exact congrArg Subtype.val h
  by_cases hx0 : x = 0
  · simp [hx0]
  have hxN : x ^ N = 1 := by
    have h : x ^ N * x = 1 * x := by
      rw [← pow_succ, Nat.sub_add_cancel (Nat.one_le_pow _ _ (by omega)), one_mul, hxq]
    exact mul_right_cancel₀ hx0 h
  let u : rootsOfUnity N (residueFieldBar K) :=
    ⟨Units.mk0 x hx0, (mem_rootsOfUnity _ _).mpr (Units.ext (by simp [hxN]))⟩
  obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp (hz u)
  have hxj : x = ((z : (residueFieldBar K)ˣ) : residueFieldBar K) ^ j := by
    have h1 : ((z ^ j : rootsOfUnity N (residueFieldBar K)) : (residueFieldBar K)ˣ) =
        Units.mk0 x hx0 := congrArg Subtype.val hj
    have h2 := congrArg Units.val h1
    simp only [Subgroup.coe_zpow, Units.val_zpow_eq_zpow_val, Units.val_mk0] at h2
    exact h2.symm
  rw [hxj, map_zpow₀, map_zpow₀, hστ]

set_option synthInstance.maxHeartbeats 200000 in
/-- On a finite subextension of `residueFieldBar K`, every automorphism is a power of the Frobenius. -/
theorem exists_frobenius_pow_eq (τ : Γ)
    (E : IntermediateField (residueField K) (residueFieldBar K))
    [FiniteDimensional (residueField K) E] :
    ∃ n : ℕ, ∀ x ∈ E, (frobenius K ^ n) x = τ x := by
  have : Finite E := Module.finite_of_finite (residueField K)
  obtain ⟨⟨n, _⟩, hn⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow
    (residueField K) E).2 (τ.restrictNormal E)
  refine ⟨n, fun x hx => ?_⟩
  have h1 : algebraMap E (residueFieldBar K) (τ.restrictNormal E ⟨x, hx⟩) = τ x :=
    AlgEquiv.restrictNormal_commutes τ E ⟨x, hx⟩
  rw [← h1, ← hn]
  simp only [frobenius, AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
  rfl

/-- The powers of the Frobenius are dense in the Galois group of `residueFieldBar K`. -/
theorem dense_zpowers_frobenius : Dense (Subgroup.zpowers (frobenius K) : Set Γ) :=
  dense_of_forall_exists_eqOn _ fun τ E hE => by
    have := hE
    obtain ⟨n, hn⟩ := exists_frobenius_pow_eq K τ E
    exact ⟨_, Subgroup.npow_mem_zpowers _ n, hn⟩

/-- The action of the absolute Galois group on `residueFieldBar K`. Every element lies in the stabilizer of `prime K`. -/
noncomputable def residueAut : Field.absoluteGaloisGroup K →* Γ :=
  (residueHom K).comp ((MonoidHom.id _).codRestrict _ (mem_stabilizer K))

@[simp]
theorem residueAut_mk (g : Field.absoluteGaloisGroup K) (ζ : integers K) :
    residueAut K g (Ideal.Quotient.mk (prime K) ζ) = Ideal.Quotient.mk (prime K) (g • ζ) :=
  rfl

/-- The action on residues is continuous for the Krull topologies. -/
theorem continuous_residueAut : Continuous (residueAut K) := by
  apply continuous_of_continuousAt_one
  rw [ContinuousAt, map_one]
  intro V hV
  obtain ⟨E, hE, hsub⟩ := (krullTopology_mem_nhds_one_iff _ _ V).mp hV
  obtain ⟨y, hy⟩ := exists_generator K E
  obtain ⟨ξ, rfl⟩ := Ideal.Quotient.mk_surjective y
  have hL : FiniteDimensional K (IntermediateField.adjoin K {(ξ : AlgebraicClosure K)}) :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral _)
  refine (krullTopology_mem_nhds_one_iff K (AlgebraicClosure K) _).mpr
    ⟨_, hL, fun g hg => hsub ?_⟩
  rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff]
  let g' : Field.absoluteGaloisGroup K := g
  refine hy (residueAut K g') 1 ?_
  have hgξ : g' • ξ = ξ := Subtype.ext ((IntermediateField.mem_fixingSubgroup_iff _ _).mp hg _
    (IntermediateField.mem_adjoin_simple_self K _))
  rw [residueAut_mk, hgξ, AlgEquiv.one_apply]

/-- Every automorphism of `residueFieldBar K` agrees at a given point with the action of an element of the absolute Galois group. The proof lifts the point, takes its minimal polynomial over `𝒪[K]` and lifts a root of the reduction. -/
theorem exists_residueAut_apply_eq (τ : Γ) (y : residueFieldBar K) :
    ∃ g : Field.absoluteGaloisGroup K, residueAut K g y = τ y := by
  obtain ⟨ξ, rfl⟩ := Ideal.Quotient.mk_surjective y
  have hξ : IsIntegral 𝒪[K] (ξ : AlgebraicClosure K) := ξ.2
  set P := minpoly 𝒪[K] (ξ : AlgebraicClosure K)
  have hPm : P.Monic := minpoly.monic hξ
  have key : ∀ z : integers K, aeval z P = 0 ↔ aeval (z : AlgebraicClosure K) P = 0 := by
    intro z
    rw [show (z : AlgebraicClosure K) = (integralClosure 𝒪[K] (AlgebraicClosure K)).val z from rfl,
      aeval_algHom_apply]
    exact (map_eq_zero_iff _ Subtype.val_injective).symm
  have hcomp : (Ideal.Quotient.mk (prime K)).comp (algebraMap 𝒪[K] (integers K)) =
      algebraMap 𝒪[K] (residueFieldBar K) := rfl
  have hx : ((P.map (algebraMap 𝒪[K] (integers K))).map (Ideal.Quotient.mk (prime K))).eval
      (τ (Ideal.Quotient.mk (prime K) ξ)) = 0 := by
    rw [Polynomial.map_map, hcomp, eval_map_algebraMap,
      ← aeval_map_algebraMap (residueField K), aeval_algHom_apply, aeval_map_algebraMap,
      ← Ideal.Quotient.mkₐ_eq_mk 𝒪[K], aeval_algHom_apply, (key ξ).mpr (minpoly.aeval _ _),
      map_zero, map_zero]
  obtain ⟨η, hη, hηy⟩ := exists_isRoot_lift K (hPm.map _) hx
  rw [eval_map_algebraMap] at hη
  have hK : minpoly K (ξ : AlgebraicClosure K) = P.map (algebraMap 𝒪[K] K) :=
    minpoly.isIntegrallyClosed_eq_field_fractions' K hξ
  have hmin : minpoly K (η : AlgebraicClosure K) = minpoly K (ξ : AlgebraicClosure K) := by
    refine (minpoly.eq_of_irreducible_of_monic
      (minpoly.irreducible (Algebra.IsIntegral.isIntegral _)) ?_
      (minpoly.monic (Algebra.IsIntegral.isIntegral _))).symm
    rw [hK, aeval_map_algebraMap]
    exact (key η).mp hη
  obtain ⟨σ, hσ⟩ := (Normal.minpoly_eq_iff_mem_orbit (AlgebraicClosure K)).mp hmin
  let σ' : Field.absoluteGaloisGroup K := σ
  refine ⟨σ', ?_⟩
  rw [residueAut_mk, ← hηy]
  congr 1
  exact Subtype.ext hσ

/-- The action on residues has dense image. -/
theorem denseRange_residueAut : DenseRange (residueAut K) :=
  dense_of_forall_exists_eqOn _ fun τ E hE => by
    have := hE
    obtain ⟨y, hy⟩ := exists_generator K E
    obtain ⟨g, hg⟩ := exists_residueAut_apply_eq K τ y
    exact ⟨_, ⟨g, rfl⟩, hy _ _ hg⟩

instance : T2Space Γ := krullTopology_t2

instance : CompactSpace (Field.absoluteGaloisGroup K) :=
  inferInstanceAs (CompactSpace Gal(AlgebraicClosure K/K))

/-- The action of the absolute Galois group on `residueFieldBar K` is surjective. -/
theorem residueAut_surjective : Function.Surjective (residueAut K) := by
  have hc : IsClosed (Set.range (residueAut K)) :=
    (isCompact_range (continuous_residueAut K)).isClosed
  have h := (denseRange_residueAut K).closure_range
  rw [hc.closure_eq] at h
  exact Set.range_eq_univ.mp h

/-- The action on residues is an open map. -/
theorem isOpenMap_residueAut : IsOpenMap (residueAut K) :=
  (MonoidHom.isOpenQuotientMap_of_isQuotientMap
    ((continuous_residueAut K).isClosedMap.isQuotientMap (continuous_residueAut K)
      (residueAut_surjective K))).isOpenMap

/-- The Weil group is the preimage of the powers of the Frobenius. -/
theorem coe_weilSubgroup : (weilSubgroup K : Set (Field.absoluteGaloisGroup K)) =
    residueAut K ⁻¹' (Subgroup.zpowers (frobenius K)) := by
  ext g
  constructor
  · rintro ⟨s, hs, rfl⟩
    exact hs
  · intro hg
    exact ⟨⟨g, mem_stabilizer K g⟩, hg, rfl⟩

end Langlands.LocalField

namespace Langlands.WeilGroup

open LocalField

variable (K : Type*) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

/-- The Weil group is dense in the absolute Galois group. -/
theorem denseRange_toGalois : DenseRange (toGalois K) := by
  have h : Set.range (toGalois K) = (weilSubgroup K : Set (Field.absoluteGaloisGroup K)) := by
    ext g
    exact ⟨fun ⟨w, hw⟩ => hw ▸ w.2, fun hg => ⟨⟨g, hg⟩, rfl⟩⟩
  rw [DenseRange, h, coe_weilSubgroup]
  exact (dense_zpowers_frobenius K).preimage (isOpenMap_residueAut K)

end Langlands.WeilGroup


